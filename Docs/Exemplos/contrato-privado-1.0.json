{
  "versaoContrato": "1.0",
  "provedor": "ERP privado de demonstração",
  "categoria": "Enriquecimento empresarial",
  "documentacao": "https://empresa.example/docs/integracao",
  "urlBase": "http://127.0.0.1:8015/v1",
  "perfilRede": "demo-local",
  "autenticacoes": [
    { "id": "erp", "tipo": "apiKeyHeader", "nome": "X-Integration-Key" }
  ],
  "plano": {
    "nome": "Demonstração local sem cobrança",
    "condicoesUso": "Dados fictícios; não consultar este exemplo como fonte factual.",
    "usoAutorizado": false,
    "mensalidade": 0,
    "orcamentoMensal": 0,
    "moeda": "BRL",
    "administrador": { "porMinuto": 10, "diario": 20, "mensal": 100 },
    "sistema": { "porMinuto": 6, "diario": 10, "mensal": 50 }
  },
  "erros": { "400": "PARAMETRO_INVALIDO", "404": "EMPRESA_NAO_ENCONTRADA", "503": "INDISPONIVEL" },
  "operacoes": [
    {
      "id": "consultarEmpresa",
      "nome": "Consultar empresa no ERP",
      "metodo": "GET",
      "caminho": "/companies/{registration}",
      "autenticacaoId": "erp",
      "permissoes": ["company.read"],
      "parametros": [
        { "nome": "registration", "local": "path", "tipo": "string", "formato": "cnpjNumerico", "obrigatorio": true, "maxComprimento": 14, "campoOrigem": "Empresa.Cnpj" }
      ],
      "correspondencia": { "parametro": "registration", "caminho": "$.registration", "normalizacao": "cnpj" },
      "caminhoItens": "$",
      "maxItensPorPagina": 1,
      "schemaResposta": {
        "type": "object",
        "required": ["registration", "organization"],
        "properties": {
          "registration": { "type": "string", "maxLength": 14, "minLength": 14 },
          "organization": { "type": "object", "required": ["legalName"], "properties": { "legalName": { "type": "string", "maxLength": 200 } } },
          "location": { "type": "object", "properties": { "city": { "type": "string" }, "state": { "type": "string", "maxLength": 2 } } }
        }
      },
      "mapeamentos": [
        { "caminho": "$.registration", "destino": "Empresa.Cnpj", "transformacao": "cnpj", "obrigatorio": true },
        { "caminho": "$.organization.legalName", "destino": "Empresa.RazaoSocial", "transformacao": "trim", "obrigatorio": true },
        { "caminho": "$.location.city", "destino": "Empresa.Cidade", "transformacao": "trim" },
        { "caminho": "$.location.state", "destino": "Empresa.Estado", "transformacao": "upper" }
      ],
      "custo": { "porRequisicao": 0, "porItem": 0, "unidade": "requisicao", "creditosPorUnidade": 1 },
      "paginacao": { "tipo": "none", "maxPaginas": 1 },
      "rotina": { "habilitada": false, "criterio": "empresasSemEvidencias", "intervaloMinutos": 720, "limitePorExecucao": 10, "persistirEvidencias": true, "politicaErros": "continuar" }
    }
  ]
}
