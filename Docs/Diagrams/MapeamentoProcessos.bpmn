  <bpmn:process id="Process_14_Demo" name="14 • Ambiente demonstrativo (OPCIONAL)" isExecutable="false">
    <bpmn:documentation>RF-DEM-001. Demonstração opcional somente com dados fictícios e isolados; não há ator Visitante neste modelo por solicitação de três atores.</bpmn:documentation>
