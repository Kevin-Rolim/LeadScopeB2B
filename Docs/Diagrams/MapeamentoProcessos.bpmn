  <bpmn:process id="Process_05_CNAE" name="05 • Classificação CNAE e segmento comercial" isExecutable="false">
    <bpmn:documentation>RF-CLA-001; RN-009; RD-004. Relação N:N via CNAES_EMPRESAS; flag principal opcional. Segmento permanece em EMPRESAS.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_05_CNAE">
      <bpmn:lane id="Lane_05_CNAE_0" name="Usuário">
        <bpmn:flowNodeRef>Node_05_CNAE_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_primary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_segment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_05_CNAE_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_05_CNAE_1" name="Revisor" />
      <bpmn:lane id="Lane_05_CNAE_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_05_CNAE_s" name="Abrir classificação da empresa">
      <bpmn:outgoing>Flow_05_CNAE_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_05_CNAE_auth" name="Sistema: verificar acesso">
      <bpmn:incoming>Flow_05_CNAE_0</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_05_CNAE_select" name="Selecionar empresa e CNAE(s)">
      <bpmn:incoming>Flow_05_CNAE_1</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_05_CNAE_valid" name="Sistema: verificar existência de Empresa / CNAEs">
      <bpmn:incoming>Flow_05_CNAE_2</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_05_CNAE_g" name="Referências válidas?">
      <bpmn:incoming>Flow_05_CNAE_3</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_05_CNAE_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_05_CNAE_err" name="Informar CNAE ou empresa inexistente">
      <bpmn:incoming>Flow_05_CNAE_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_05_CNAE_primary" name="Definir CNAE principal quando conhecido">
      <bpmn:incoming>Flow_05_CNAE_5</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_05_CNAE_segment" name="Informar segmento comercial da Empresa">
      <bpmn:incoming>Flow_05_CNAE_6</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_05_CNAE_save" name="Sistema: gravar CNAES_EMPRESAS e EMPRESAS">
      <bpmn:documentation>Preservar unicidade do par CNAE-Empresa; CNAE principal não é obrigatório.</bpmn:documentation>
      <bpmn:incoming>Flow_05_CNAE_7</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_05_CNAE_audit" name="Sistema: registrar alteração">
      <bpmn:incoming>Flow_05_CNAE_8</bpmn:incoming>
      <bpmn:outgoing>Flow_05_CNAE_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_05_CNAE_end" name="Classificação atualizada">
      <bpmn:incoming>Flow_05_CNAE_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_05_CNAE_0" sourceRef="Node_05_CNAE_s" targetRef="Node_05_CNAE_auth" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_1" sourceRef="Node_05_CNAE_auth" targetRef="Node_05_CNAE_select" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_2" sourceRef="Node_05_CNAE_select" targetRef="Node_05_CNAE_valid" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_3" sourceRef="Node_05_CNAE_valid" targetRef="Node_05_CNAE_g" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_4" name="Não" sourceRef="Node_05_CNAE_g" targetRef="Node_05_CNAE_err" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_5" name="Sim" sourceRef="Node_05_CNAE_g" targetRef="Node_05_CNAE_primary" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_6" sourceRef="Node_05_CNAE_primary" targetRef="Node_05_CNAE_segment" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_7" sourceRef="Node_05_CNAE_segment" targetRef="Node_05_CNAE_save" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_8" sourceRef="Node_05_CNAE_save" targetRef="Node_05_CNAE_audit" />
    <bpmn:sequenceFlow id="Flow_05_CNAE_9" sourceRef="Node_05_CNAE_audit" targetRef="Node_05_CNAE_end" />
  </bpmn:process>
  <bpmn:process id="Process_06_FontesDados" name="06 • Gestão de fontes e registro MANUAL de evidências" isExecutable="false">
    <bpmn:documentation>RF-FON-001 + RF-COL-001 adaptado para o escopo atual: cadastro de fonte e coleta manual; RN-003/004/005. Consultas automáticas a APIs estão excluídas.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_06_FontesDados">
      <bpmn:lane id="Lane_06_FontesDados_0" name="Usuário">
        <bpmn:flowNodeRef>Node_06_FontesDados_su</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_permu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_target</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_norm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_06_FontesDados_1" name="Revisor" />
      <bpmn:lane id="Lane_06_FontesDados_2" name="Administrador">
        <bpmn:flowNodeRef>Node_06_FontesDados_sadm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_perma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_fonte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_auditA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_06_FontesDados_enda</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_06_FontesDados_sadm" name="Abrir catálogo de fontes">
      <bpmn:outgoing>Flow_06_FontesDados_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_06_FontesDados_perma" name="Sistema: validar gestão administrativa">
      <bpmn:incoming>Flow_06_FontesDados_0</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_06_FontesDados_fonte" name="Cadastrar, editar ou inativar fonte">
      <bpmn:documentation>Nome, tipo, URL, confiabilidade padrão, estado, data de inativação. Fonte inativa permanece para auditoria.</bpmn:documentation>
      <bpmn:incoming>Flow_06_FontesDados_1</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_06_FontesDados_auditA" name="Sistema: gravar fonte e LOGS">
      <bpmn:incoming>Flow_06_FontesDados_2</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_06_FontesDados_enda" name="Fonte gerenciada">
      <bpmn:incoming>Flow_06_FontesDados_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Node_06_FontesDados_su" name="Solicitar registro de dado complementar">
      <bpmn:outgoing>Flow_06_FontesDados_4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_06_FontesDados_permu" name="Sistema: verificar permissão de inclusão">
      <bpmn:incoming>Flow_06_FontesDados_4</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_06_FontesDados_target" name="Selecionar fonte e Pessoa OU Empresa">
      <bpmn:incoming>Flow_06_FontesDados_5</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_06_FontesDados_data" name="Informar campo, valor e evidência">
      <bpmn:documentation>Guardar valor original; valor normalizado quando aplicável; confiança específica e status de validação.</bpmn:documentation>
      <bpmn:incoming>Flow_06_FontesDados_6</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_06_FontesDados_check" name="Sistema: validar fonte e destino exclusivo">
      <bpmn:documentation>Cada DADO_COLETADO tem 1 FONTES_DADOS; pessoa_id XOR empresa_id; nenhuma referência órfã. Fonte inativa não deve originar novas entradas sem autorização.</bpmn:documentation>
      <bpmn:incoming>Flow_06_FontesDados_7</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_06_FontesDados_valid" name="Registro válido?">
      <bpmn:incoming>Flow_06_FontesDados_8</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_06_FontesDados_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_06_FontesDados_fail" name="Recusar registro inconsistente">
      <bpmn:incoming>Flow_06_FontesDados_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_06_FontesDados_norm" name="Sistema: normalizar sem apagar original">
      <bpmn:incoming>Flow_06_FontesDados_10</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_06_FontesDados_valida" name="Valor canônico deve ser alterado?">
      <bpmn:incoming>Flow_06_FontesDados_11</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_06_FontesDados_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_06_FontesDados_keep" name="Manter somente DADOS_COLETADOS">
      <bpmn:incoming>Flow_06_FontesDados_12</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_06_FontesDados_review" name="Aplicar atributo após validação manual">
      <bpmn:documentation>Nunca sobrescrever atributo conflitante automaticamente; preservar evidências e origem.</bpmn:documentation>
      <bpmn:incoming>Flow_06_FontesDados_13</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_06_FontesDados_save" name="Sistema: persistir evidência e alterações">
      <bpmn:incoming>Flow_06_FontesDados_14</bpmn:incoming>
      <bpmn:incoming>Flow_06_FontesDados_15</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_06_FontesDados_audit" name="Sistema: registrar LOGS relevante">
      <bpmn:incoming>Flow_06_FontesDados_16</bpmn:incoming>
      <bpmn:outgoing>Flow_06_FontesDados_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_06_FontesDados_end" name="Dado manual rastreável">
      <bpmn:incoming>Flow_06_FontesDados_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_06_FontesDados_0" sourceRef="Node_06_FontesDados_sadm" targetRef="Node_06_FontesDados_perma" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_1" sourceRef="Node_06_FontesDados_perma" targetRef="Node_06_FontesDados_fonte" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_2" sourceRef="Node_06_FontesDados_fonte" targetRef="Node_06_FontesDados_auditA" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_3" sourceRef="Node_06_FontesDados_auditA" targetRef="Node_06_FontesDados_enda" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_4" sourceRef="Node_06_FontesDados_su" targetRef="Node_06_FontesDados_permu" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_5" sourceRef="Node_06_FontesDados_permu" targetRef="Node_06_FontesDados_target" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_6" sourceRef="Node_06_FontesDados_target" targetRef="Node_06_FontesDados_data" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_7" sourceRef="Node_06_FontesDados_data" targetRef="Node_06_FontesDados_check" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_8" sourceRef="Node_06_FontesDados_check" targetRef="Node_06_FontesDados_valid" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_9" name="Não" sourceRef="Node_06_FontesDados_valid" targetRef="Node_06_FontesDados_fail" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_10" name="Sim" sourceRef="Node_06_FontesDados_valid" targetRef="Node_06_FontesDados_norm" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_11" sourceRef="Node_06_FontesDados_norm" targetRef="Node_06_FontesDados_valida" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_12" name="Não" sourceRef="Node_06_FontesDados_valida" targetRef="Node_06_FontesDados_keep" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_13" name="Sim" sourceRef="Node_06_FontesDados_valida" targetRef="Node_06_FontesDados_review" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_14" sourceRef="Node_06_FontesDados_keep" targetRef="Node_06_FontesDados_save" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_15" sourceRef="Node_06_FontesDados_review" targetRef="Node_06_FontesDados_save" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_16" sourceRef="Node_06_FontesDados_save" targetRef="Node_06_FontesDados_audit" />
    <bpmn:sequenceFlow id="Flow_06_FontesDados_17" sourceRef="Node_06_FontesDados_audit" targetRef="Node_06_FontesDados_end" />
  </bpmn:process>
  <bpmn:process id="Process_07_Pesquisa" name="07 • Pesquisa, filtros, consulta e paginação" isExecutable="false">
    <bpmn:documentation>RF-BUS-001; RNF-DES-001. Consultar Empresas, Pessoas, PESSOAS_EMPRESAS, CNAES, CNAES_EMPRESAS, DADOS_COLETADOS; não consultar APIs online.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_07_Pesquisa">
      <bpmn:lane id="Lane_07_Pesquisa_0" name="Usuário">
        <bpmn:flowNodeRef>Node_07_Pesquisa_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_filters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_rows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_07_Pesquisa_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_07_Pesquisa_1" name="Revisor" />
      <bpmn:lane id="Lane_07_Pesquisa_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_07_Pesquisa_s" name="Abrir catálogo e informar filtros">
      <bpmn:outgoing>Flow_07_Pesquisa_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_07_Pesquisa_auth" name="Sistema: verificar sessão e permissões">
      <bpmn:incoming>Flow_07_Pesquisa_0</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_07_Pesquisa_g" name="Pode consultar?">
      <bpmn:incoming>Flow_07_Pesquisa_1</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_07_Pesquisa_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_07_Pesquisa_deny" name="Acesso à pesquisa negado">
      <bpmn:incoming>Flow_07_Pesquisa_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_07_Pesquisa_filters" name="Combinar filtros empresariais e profissionais">
      <bpmn:documentation>Empresa: nome, CNPJ, localização, porte, CNAE, segmento, matriz/filial. Pessoa/vínculo: nome, cargo, departamento, senioridade, status, confiança, contato profissional.</bpmn:documentation>
      <bpmn:incoming>Flow_07_Pesquisa_3</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_07_Pesquisa_query" name="Sistema: consultar base local com índices e paginação">
      <bpmn:incoming>Flow_07_Pesquisa_4</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_07_Pesquisa_rows" name="Há resultados válidos?">
      <bpmn:incoming>Flow_07_Pesquisa_5</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_07_Pesquisa_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_07_Pesquisa_empty" name="Exibir lista vazia / ajustar filtros">
      <bpmn:incoming>Flow_07_Pesquisa_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_07_Pesquisa_list" name="Exibir resultados com paginação">
      <bpmn:incoming>Flow_07_Pesquisa_7</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_07_Pesquisa_choose" name="Selecionar empresa, pessoa ou lead">
      <bpmn:incoming>Flow_07_Pesquisa_8</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_07_Pesquisa_details" name="Sistema: exibir vínculos, CNAEs e evidências permitidas">
      <bpmn:documentation>Respeitar bloqueios/remoções e confidencialidade de dados; origem da informação disponível quando autorizada.</bpmn:documentation>
      <bpmn:incoming>Flow_07_Pesquisa_9</bpmn:incoming>
      <bpmn:outgoing>Flow_07_Pesquisa_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_07_Pesquisa_end" name="Consulta concluída">
      <bpmn:incoming>Flow_07_Pesquisa_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_0" sourceRef="Node_07_Pesquisa_s" targetRef="Node_07_Pesquisa_auth" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_1" sourceRef="Node_07_Pesquisa_auth" targetRef="Node_07_Pesquisa_g" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_2" name="Não" sourceRef="Node_07_Pesquisa_g" targetRef="Node_07_Pesquisa_deny" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_3" name="Sim" sourceRef="Node_07_Pesquisa_g" targetRef="Node_07_Pesquisa_filters" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_4" sourceRef="Node_07_Pesquisa_filters" targetRef="Node_07_Pesquisa_query" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_5" sourceRef="Node_07_Pesquisa_query" targetRef="Node_07_Pesquisa_rows" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_6" name="Não" sourceRef="Node_07_Pesquisa_rows" targetRef="Node_07_Pesquisa_empty" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_7" name="Sim" sourceRef="Node_07_Pesquisa_rows" targetRef="Node_07_Pesquisa_list" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_8" sourceRef="Node_07_Pesquisa_list" targetRef="Node_07_Pesquisa_choose" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_9" sourceRef="Node_07_Pesquisa_choose" targetRef="Node_07_Pesquisa_details" />
    <bpmn:sequenceFlow id="Flow_07_Pesquisa_10" sourceRef="Node_07_Pesquisa_details" targetRef="Node_07_Pesquisa_end" />
  </bpmn:process>
  <bpmn:process id="Process_08_Revisao" name="08 • Revisão humana do vínculo / lead" isExecutable="false">
    <bpmn:documentation>RF-REV-001; RN-007; RD-006. Revisao vincula um usuário Revisor ao par Pessoa–Empresa, não é avaliação genérica de qualquer registro.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_08_Revisao">
      <bpmn:lane id="Lane_08_Revisao_0" name="Usuário">
        <bpmn:flowNodeRef>Node_08_Revisao_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_08_Revisao_1" name="Revisor">
        <bpmn:flowNodeRef>Node_08_Revisao_startrev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_den</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_endp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_gdec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_08_Revisao_audit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_08_Revisao_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_08_Revisao_s" name="Identificar lead que exige revisão">
      <bpmn:outgoing>Flow_08_Revisao_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Node_08_Revisao_send" name="Solicitar avaliação do vínculo">
      <bpmn:incoming>Flow_08_Revisao_0</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_08_Revisao_startrev" name="Abrir vínculo para revisão">
      <bpmn:incoming>Flow_08_Revisao_1</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_08_Revisao_auth" name="Sistema: validar permissão de Revisor">
      <bpmn:incoming>Flow_08_Revisao_2</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_08_Revisao_ga" name="Revisor autorizado?">
      <bpmn:incoming>Flow_08_Revisao_3</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_Revisao_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_08_Revisao_den" name="Revisão negada">
      <bpmn:incoming>Flow_08_Revisao_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_08_Revisao_load" name="Sistema: recuperar Pessoa, Empresa, vínculo e fontes">
      <bpmn:incoming>Flow_08_Revisao_5</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_08_Revisao_evidence" name="Examinar dados, evidências e nível de confiança">
      <bpmn:incoming>Flow_08_Revisao_6</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_08_Revisao_enough" name="Evidência suficiente?">
      <bpmn:incoming>Flow_08_Revisao_7</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_Revisao_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_08_Revisao_pending" name="Manter em análise e solicitar complementação">
      <bpmn:incoming>Flow_08_Revisao_8</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_08_Revisao_endp" name="Revisão pendente de dados">
      <bpmn:incoming>Flow_08_Revisao_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_08_Revisao_decision" name="Registrar decisão e comentário">
      <bpmn:incoming>Flow_08_Revisao_10</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_08_Revisao_gdec" name="Lead qualificado?">
      <bpmn:incoming>Flow_08_Revisao_11</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_08_Revisao_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_08_Revisao_accept" name="Atualizar status_lead = QUALIFICADO">
      <bpmn:incoming>Flow_08_Revisao_12</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_08_Revisao_reject" name="Atualizar status_lead = REJEITADO ou conforme decisão">
      <bpmn:incoming>Flow_08_Revisao_13</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_08_Revisao_save" name="Sistema: persistir REVISOES e vínculo em transação">
      <bpmn:documentation>Revisões têm usuário, data, decisão, comentário e FK composta (pessoa_id, empresa_id).</bpmn:documentation>
      <bpmn:incoming>Flow_08_Revisao_14</bpmn:incoming>
      <bpmn:incoming>Flow_08_Revisao_15</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_08_Revisao_audit" name="Sistema: registrar evento em LOGS">
      <bpmn:incoming>Flow_08_Revisao_16</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_08_Revisao_notice" name="Consultar resultado revisado">
      <bpmn:incoming>Flow_08_Revisao_17</bpmn:incoming>
      <bpmn:outgoing>Flow_08_Revisao_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_08_Revisao_end" name="Revisão concluída e rastreável">
      <bpmn:incoming>Flow_08_Revisao_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_08_Revisao_0" sourceRef="Node_08_Revisao_s" targetRef="Node_08_Revisao_send" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_1" sourceRef="Node_08_Revisao_send" targetRef="Node_08_Revisao_startrev" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_2" sourceRef="Node_08_Revisao_startrev" targetRef="Node_08_Revisao_auth" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_3" sourceRef="Node_08_Revisao_auth" targetRef="Node_08_Revisao_ga" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_4" name="Não" sourceRef="Node_08_Revisao_ga" targetRef="Node_08_Revisao_den" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_5" name="Sim" sourceRef="Node_08_Revisao_ga" targetRef="Node_08_Revisao_load" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_6" sourceRef="Node_08_Revisao_load" targetRef="Node_08_Revisao_evidence" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_7" sourceRef="Node_08_Revisao_evidence" targetRef="Node_08_Revisao_enough" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_8" name="Não" sourceRef="Node_08_Revisao_enough" targetRef="Node_08_Revisao_pending" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_9" sourceRef="Node_08_Revisao_pending" targetRef="Node_08_Revisao_endp" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_10" name="Sim" sourceRef="Node_08_Revisao_enough" targetRef="Node_08_Revisao_decision" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_11" sourceRef="Node_08_Revisao_decision" targetRef="Node_08_Revisao_gdec" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_12" name="Sim" sourceRef="Node_08_Revisao_gdec" targetRef="Node_08_Revisao_accept" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_13" name="Não" sourceRef="Node_08_Revisao_gdec" targetRef="Node_08_Revisao_reject" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_14" sourceRef="Node_08_Revisao_accept" targetRef="Node_08_Revisao_save" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_15" sourceRef="Node_08_Revisao_reject" targetRef="Node_08_Revisao_save" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_16" sourceRef="Node_08_Revisao_save" targetRef="Node_08_Revisao_audit" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_17" sourceRef="Node_08_Revisao_audit" targetRef="Node_08_Revisao_notice" />
    <bpmn:sequenceFlow id="Flow_08_Revisao_18" sourceRef="Node_08_Revisao_notice" targetRef="Node_08_Revisao_end" />
  </bpmn:process>
  <bpmn:process id="Process_09_Exportacao" name="09 • Seleção e exportação de leads CSV" isExecutable="false">
    <bpmn:documentation>RF-EXP-001; RN-008; RD-007. EXPORTACOES e EXPORTACOES_PESSOAS_EMPRESAS; unidade exportável é par Pessoa–Empresa.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_09_Exportacao">
      <bpmn:lane id="Lane_09_Exportacao_0" name="Usuário">
        <bpmn:flowNodeRef>Node_09_Exportacao_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_eligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_gsel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_csv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_gfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_09_Exportacao_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_09_Exportacao_1" name="Revisor" />
      <bpmn:lane id="Lane_09_Exportacao_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_09_Exportacao_s" name="Selecionar leads nos resultados">
      <bpmn:outgoing>Flow_09_Exportacao_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_09_Exportacao_auth" name="Sistema: revalidar autorização">
      <bpmn:incoming>Flow_09_Exportacao_0</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_09_Exportacao_ga" name="Exportação permitida?">
      <bpmn:incoming>Flow_09_Exportacao_1</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_Exportacao_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_09_Exportacao_deny" name="Exportação bloqueada">
      <bpmn:incoming>Flow_09_Exportacao_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_09_Exportacao_selection" name="Confirmar seleção e filtros aplicados">
      <bpmn:incoming>Flow_09_Exportacao_3</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_09_Exportacao_eligible" name="Sistema: excluir bloqueados, removidos ou restritos">
      <bpmn:incoming>Flow_09_Exportacao_4</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_09_Exportacao_gsel" name="Restaram pares exportáveis?">
      <bpmn:incoming>Flow_09_Exportacao_5</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_Exportacao_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_09_Exportacao_empty" name="Informar seleção vazia">
      <bpmn:incoming>Flow_09_Exportacao_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_09_Exportacao_record" name="Sistema: criar EXPORTACOES com usuário, data, filtros, formato e quantidade">
      <bpmn:incoming>Flow_09_Exportacao_7</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_09_Exportacao_link" name="Sistema: relacionar cada Pessoa–Empresa exportada">
      <bpmn:documentation>Inserir em EXPORTACOES_PESSOAS_EMPRESAS com integridade referencial; mesma pessoa-empresa pode constar em exportações distintas.</bpmn:documentation>
      <bpmn:incoming>Flow_09_Exportacao_8</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_09_Exportacao_csv" name="Sistema: gerar arquivo CSV autorizado">
      <bpmn:incoming>Flow_09_Exportacao_9</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_09_Exportacao_gfile" name="Arquivo gerado corretamente?">
      <bpmn:incoming>Flow_09_Exportacao_10</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_09_Exportacao_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_09_Exportacao_rollback" name="Sistema: reverter operação incompleta">
      <bpmn:incoming>Flow_09_Exportacao_11</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_09_Exportacao_fail" name="Exportação cancelada / erro controlado">
      <bpmn:incoming>Flow_09_Exportacao_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_09_Exportacao_audit" name="Sistema: gravar LOGS e apresentar arquivo">
      <bpmn:incoming>Flow_09_Exportacao_13</bpmn:incoming>
      <bpmn:outgoing>Flow_09_Exportacao_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_09_Exportacao_end" name="CSV disponível e operação auditada">
      <bpmn:incoming>Flow_09_Exportacao_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_09_Exportacao_0" sourceRef="Node_09_Exportacao_s" targetRef="Node_09_Exportacao_auth" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_1" sourceRef="Node_09_Exportacao_auth" targetRef="Node_09_Exportacao_ga" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_2" name="Não" sourceRef="Node_09_Exportacao_ga" targetRef="Node_09_Exportacao_deny" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_3" name="Sim" sourceRef="Node_09_Exportacao_ga" targetRef="Node_09_Exportacao_selection" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_4" sourceRef="Node_09_Exportacao_selection" targetRef="Node_09_Exportacao_eligible" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_5" sourceRef="Node_09_Exportacao_eligible" targetRef="Node_09_Exportacao_gsel" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_6" name="Não" sourceRef="Node_09_Exportacao_gsel" targetRef="Node_09_Exportacao_empty" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_7" name="Sim" sourceRef="Node_09_Exportacao_gsel" targetRef="Node_09_Exportacao_record" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_8" sourceRef="Node_09_Exportacao_record" targetRef="Node_09_Exportacao_link" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_9" sourceRef="Node_09_Exportacao_link" targetRef="Node_09_Exportacao_csv" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_10" sourceRef="Node_09_Exportacao_csv" targetRef="Node_09_Exportacao_gfile" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_11" name="Não" sourceRef="Node_09_Exportacao_gfile" targetRef="Node_09_Exportacao_rollback" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_12" sourceRef="Node_09_Exportacao_rollback" targetRef="Node_09_Exportacao_fail" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_13" name="Sim" sourceRef="Node_09_Exportacao_gfile" targetRef="Node_09_Exportacao_audit" />
    <bpmn:sequenceFlow id="Flow_09_Exportacao_14" sourceRef="Node_09_Exportacao_audit" targetRef="Node_09_Exportacao_end" />
  </bpmn:process>
  <bpmn:process id="Process_10_Administracao" name="10 • Contas, perfis e conjuntos de permissões" isExecutable="false">
    <bpmn:documentation>RF-USR-001; RN-001; RN-011; RNF-SEG-001. Cada Usuario tem PerfilAcesso; cada PerfilAcesso tem ConjuntoPermissoes.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_10_Administracao">
      <bpmn:lane id="Lane_10_Administracao_0" name="Usuário" />
      <bpmn:lane id="Lane_10_Administracao_1" name="Revisor" />
      <bpmn:lane id="Lane_10_Administracao_2" name="Administrador">
        <bpmn:flowNodeRef>Node_10_Administracao_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_den</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_cat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_user</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_perm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_10_Administracao_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_10_Administracao_s" name="Abrir módulo administrativo">
      <bpmn:outgoing>Flow_10_Administracao_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_10_Administracao_auth" name="Sistema: confirmar status e permissão administrativa">
      <bpmn:incoming>Flow_10_Administracao_0</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_10_Administracao_g" name="Permissão administrativa?">
      <bpmn:incoming>Flow_10_Administracao_1</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_Administracao_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_10_Administracao_den" name="Acesso negado">
      <bpmn:incoming>Flow_10_Administracao_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_10_Administracao_select" name="Escolher usuários, perfis ou conjuntos">
      <bpmn:incoming>Flow_10_Administracao_3</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_10_Administracao_cat" name="Objeto de administração?">
      <bpmn:incoming>Flow_10_Administracao_4</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_Administracao_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_Administracao_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_10_Administracao_user" name="Criar/atualizar conta, senha e status">
      <bpmn:documentation>E-mail único; hash seguro; status ATIVO/BLOQUEADO/DESATIVADO; perfil obrigatório.</bpmn:documentation>
      <bpmn:incoming>Flow_10_Administracao_5</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_10_Administracao_profile" name="Cadastrar / alterar PerfilAcesso">
      <bpmn:incoming>Flow_10_Administracao_6</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_10_Administracao_perm" name="Cadastrar / alterar ConjuntoPermissoes">
      <bpmn:incoming>Flow_10_Administracao_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Administracao_10</bpmn:outgoing>
