    <bpmn:serviceTask id="Node_04_Vinculos_auth" name="Sistema: verificar permissão e existência">
      <bpmn:incoming>Flow_04_Vinculos_0</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_04_Vinculos_g" name="Dados e acesso válidos?">
      <bpmn:incoming>Flow_04_Vinculos_1</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_Vinculos_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_04_Vinculos_deny" name="Impedir vínculo inválido">
      <bpmn:incoming>Flow_04_Vinculos_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_04_Vinculos_find" name="Sistema: localizar par Pessoa–Empresa">
      <bpmn:incoming>Flow_04_Vinculos_3</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_04_Vinculos_exist" name="Vínculo já existe?">
      <bpmn:incoming>Flow_04_Vinculos_4</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_Vinculos_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_04_Vinculos_new" name="Iniciar criação de vínculo">
      <bpmn:incoming>Flow_04_Vinculos_5</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_04_Vinculos_edit" name="Selecionar atualização do vínculo">
      <bpmn:incoming>Flow_04_Vinculos_6</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_04_Vinculos_fields" name="Informar cargo, departamento, senioridade e tipo">
      <bpmn:documentation>Incluir qualificação formal, fonte do vínculo, data de verificação e nível de confiança quando conhecidos.</bpmn:documentation>
      <bpmn:incoming>Flow_04_Vinculos_7</bpmn:incoming>
      <bpmn:incoming>Flow_04_Vinculos_8</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_04_Vinculos_statuses" name="Definir status profissional e comercial">
      <bpmn:documentation>status_vinculo ATIVO/INATIVO/INCERTO; status_lead NOVO/EM_ANALISE/QUALIFICADO/REJEITADO conforme regras.</bpmn:documentation>
      <bpmn:incoming>Flow_04_Vinculos_9</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_04_Vinculos_check" name="Sistema: validar unicidade e referências">
