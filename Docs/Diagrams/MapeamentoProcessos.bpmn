  <bpmn:process id="Process_03_Pessoas" name="03 • Cadastrar, consultar, atualizar, bloquear e remover pessoas" isExecutable="false">
    <bpmn:documentation>RF-PES-001; RN-010; RNF-PRI-001. Somente dados necessários ao contexto B2B.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_03_Pessoas">
      <bpmn:lane id="Lane_03_Pessoas_0" name="Usuário">
        <bpmn:flowNodeRef>Node_03_Pessoas_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_ga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_gv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_03_Pessoas_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_03_Pessoas_1" name="Revisor" />
      <bpmn:lane id="Lane_03_Pessoas_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_03_Pessoas_s" name="Iniciar manutenção de pessoa">
      <bpmn:outgoing>Flow_03_Pessoas_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_03_Pessoas_auth" name="Sistema: confirmar permissão">
      <bpmn:incoming>Flow_03_Pessoas_0</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_03_Pessoas_ga" name="Permissão concedida?">
      <bpmn:incoming>Flow_03_Pessoas_1</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_03_Pessoas_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_03_Pessoas_deny" name="Acesso negado">
      <bpmn:incoming>Flow_03_Pessoas_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_03_Pessoas_form" name="Informar nome, contatos e perfil profissional">
      <bpmn:documentation>Nome, e-mail profissional, telefone comercial, URL de perfil e localização quando disponíveis; pessoa sem localização é permitida.</bpmn:documentation>
      <bpmn:incoming>Flow_03_Pessoas_3</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_03_Pessoas_act" name="Definir cadastro, edição, bloqueio ou remoção lógica">
      <bpmn:incoming>Flow_03_Pessoas_4</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_03_Pessoas_validate" name="Sistema: validar finalidade, formato e minimização">
      <bpmn:incoming>Flow_03_Pessoas_5</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_03_Pessoas_gv" name="Dados / operação válidos?">
      <bpmn:incoming>Flow_03_Pessoas_6</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_03_Pessoas_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_03_Pessoas_err" name="Informar inconsistências">
      <bpmn:incoming>Flow_03_Pessoas_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_03_Pessoas_save" name="Sistema: aplicar status, data_bloqueio ou data_del">
      <bpmn:documentation>Preservar histórico necessário; pessoas bloqueadas/removidas não devem reaparecer em buscas/exportações indevidas.</bpmn:documentation>
      <bpmn:incoming>Flow_03_Pessoas_8</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_03_Pessoas_log" name="Sistema: registrar alteração em LOGS">
      <bpmn:incoming>Flow_03_Pessoas_9</bpmn:incoming>
      <bpmn:outgoing>Flow_03_Pessoas_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_03_Pessoas_end" name="Pessoa mantida com rastreabilidade">
      <bpmn:incoming>Flow_03_Pessoas_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_03_Pessoas_0" sourceRef="Node_03_Pessoas_s" targetRef="Node_03_Pessoas_auth" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_1" sourceRef="Node_03_Pessoas_auth" targetRef="Node_03_Pessoas_ga" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_2" name="Não" sourceRef="Node_03_Pessoas_ga" targetRef="Node_03_Pessoas_deny" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_3" name="Sim" sourceRef="Node_03_Pessoas_ga" targetRef="Node_03_Pessoas_form" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_4" sourceRef="Node_03_Pessoas_form" targetRef="Node_03_Pessoas_act" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_5" sourceRef="Node_03_Pessoas_act" targetRef="Node_03_Pessoas_validate" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_6" sourceRef="Node_03_Pessoas_validate" targetRef="Node_03_Pessoas_gv" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_7" name="Não" sourceRef="Node_03_Pessoas_gv" targetRef="Node_03_Pessoas_err" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_8" name="Sim" sourceRef="Node_03_Pessoas_gv" targetRef="Node_03_Pessoas_save" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_9" sourceRef="Node_03_Pessoas_save" targetRef="Node_03_Pessoas_log" />
    <bpmn:sequenceFlow id="Flow_03_Pessoas_10" sourceRef="Node_03_Pessoas_log" targetRef="Node_03_Pessoas_end" />
  </bpmn:process>
  <bpmn:process id="Process_04_Vinculos" name="04 • Vínculo Pessoa–Empresa e classificação do lead" isExecutable="false">
    <bpmn:documentation>RF-VIN-001; RN-006; RD-003. Um registro por par Pessoa–Empresa; separar status_vinculo de status_lead.</bpmn:documentation>
