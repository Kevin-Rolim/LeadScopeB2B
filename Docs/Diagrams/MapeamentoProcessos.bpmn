  <bpmn:process id="Process_01_Acesso" name="01 • Autenticação, controle de sessão e logout" isExecutable="false">
    <bpmn:documentation>RF-AUT-001; RN-001, RN-011; RNF-SEG-001, RNF-PRI-001.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_01_Acesso">
      <bpmn:lane id="Lane_01_Acesso_0" name="Usuário">
        <bpmn:flowNodeRef>Node_01_Acesso_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_cred</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_hash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_bad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_st</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_gs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_denyb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_prof</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_sess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_sair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_logout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_01_Acesso_fims</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_01_Acesso_1" name="Revisor" />
      <bpmn:lane id="Lane_01_Acesso_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_01_Acesso_s" name="Solicitar autenticação">
      <bpmn:outgoing>Flow_01_Acesso_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Node_01_Acesso_cred" name="Informar e-mail e senha">
      <bpmn:incoming>Flow_01_Acesso_0</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_01_Acesso_hash" name="Sistema: buscar usuário e validar hash">
      <bpmn:documentation>Nunca guardar ou comparar senha em texto puro; credenciais são verificadas com método seguro.</bpmn:documentation>
      <bpmn:incoming>Flow_01_Acesso_1</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_01_Acesso_g" name="Credenciais válidas?">
      <bpmn:incoming>Flow_01_Acesso_2</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_01_Acesso_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_01_Acesso_bad" name="Informar falha genérica">
      <bpmn:incoming>Flow_01_Acesso_3</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_01_Acesso_deny" name="Acesso negado">
      <bpmn:incoming>Flow_01_Acesso_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_01_Acesso_st" name="Sistema: consultar status da conta">
      <bpmn:incoming>Flow_01_Acesso_5</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_01_Acesso_gs" name="Conta ativa?">
      <bpmn:incoming>Flow_01_Acesso_6</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_01_Acesso_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_01_Acesso_block" name="Impedir sessão de conta bloqueada/desativada">
      <bpmn:incoming>Flow_01_Acesso_7</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_01_Acesso_denyb" name="Sessão recusada">
      <bpmn:incoming>Flow_01_Acesso_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_01_Acesso_prof" name="Sistema: carregar PerfilAcesso e ConjuntoPermissoes">
      <bpmn:documentation>Usuario -&gt; PerfilAcesso -&gt; ConjuntoPermissoes; todas as ações no backend exigem permissão.</bpmn:documentation>
      <bpmn:incoming>Flow_01_Acesso_9</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_01_Acesso_sess" name="Sistema: criar sessão protegida">
      <bpmn:incoming>Flow_01_Acesso_10</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_01_Acesso_ok" name="Sessão autenticada">
      <bpmn:incoming>Flow_01_Acesso_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Node_01_Acesso_sair" name="Solicitar saída da conta">
      <bpmn:outgoing>Flow_01_Acesso_12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_01_Acesso_logout" name="Sistema: invalidar sessão">
      <bpmn:incoming>Flow_01_Acesso_12</bpmn:incoming>
      <bpmn:outgoing>Flow_01_Acesso_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_01_Acesso_fims" name="Sessão encerrada">
      <bpmn:incoming>Flow_01_Acesso_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01_Acesso_0" sourceRef="Node_01_Acesso_s" targetRef="Node_01_Acesso_cred" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_1" sourceRef="Node_01_Acesso_cred" targetRef="Node_01_Acesso_hash" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_2" sourceRef="Node_01_Acesso_hash" targetRef="Node_01_Acesso_g" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_3" name="Não" sourceRef="Node_01_Acesso_g" targetRef="Node_01_Acesso_bad" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_4" sourceRef="Node_01_Acesso_bad" targetRef="Node_01_Acesso_deny" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_5" name="Sim" sourceRef="Node_01_Acesso_g" targetRef="Node_01_Acesso_st" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_6" sourceRef="Node_01_Acesso_st" targetRef="Node_01_Acesso_gs" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_7" name="Não" sourceRef="Node_01_Acesso_gs" targetRef="Node_01_Acesso_block" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_8" sourceRef="Node_01_Acesso_block" targetRef="Node_01_Acesso_denyb" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_9" name="Sim" sourceRef="Node_01_Acesso_gs" targetRef="Node_01_Acesso_prof" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_10" sourceRef="Node_01_Acesso_prof" targetRef="Node_01_Acesso_sess" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_11" sourceRef="Node_01_Acesso_sess" targetRef="Node_01_Acesso_ok" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_12" sourceRef="Node_01_Acesso_sair" targetRef="Node_01_Acesso_logout" />
    <bpmn:sequenceFlow id="Flow_01_Acesso_13" sourceRef="Node_01_Acesso_logout" targetRef="Node_01_Acesso_fims" />
  </bpmn:process>
  <bpmn:process id="Process_02_Empresas" name="02 • Cadastrar, consultar, atualizar e inativar empresas" isExecutable="false">
    <bpmn:documentation>RF-EMP-001; RN-002, RN-010; RNF-INT-001. CNPJ opcional, único quando presente. Remoção preferencialmente lógica.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_02_Empresas">
      <bpmn:lane id="Lane_02_Empresas_0" name="Usuário">
        <bpmn:flowNodeRef>Node_02_Empresas_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_perm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_gp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_norm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_gvalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_erro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_gdup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_duperr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_02_Empresas_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_02_Empresas_1" name="Revisor" />
      <bpmn:lane id="Lane_02_Empresas_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_02_Empresas_s" name="Abrir manutenção de empresas">
      <bpmn:outgoing>Flow_02_Empresas_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Node_02_Empresas_perm" name="Sistema: verificar permissão">
      <bpmn:incoming>Flow_02_Empresas_0</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_02_Empresas_gp" name="Autorizado?">
      <bpmn:incoming>Flow_02_Empresas_1</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_Empresas_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_02_Empresas_no" name="Bloquear operação">
      <bpmn:incoming>Flow_02_Empresas_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_02_Empresas_act" name="Selecionar incluir, editar ou inativar">
      <bpmn:incoming>Flow_02_Empresas_3</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_02_Empresas_dados" name="Informar dados cadastrais e comerciais">
      <bpmn:documentation>Razão social obrigatória; nome fantasia, matriz/filial, porte, segmento, endereço, situação, contato institucional e CNPJ opcional.</bpmn:documentation>
      <bpmn:incoming>Flow_02_Empresas_4</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_02_Empresas_norm" name="Sistema: validar e normalizar CNPJ / campos">
      <bpmn:documentation>Se CNPJ informado: normalizar a 14 dígitos; validar formato; localizar mesma empresa antes de persistir.</bpmn:documentation>
      <bpmn:incoming>Flow_02_Empresas_5</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_02_Empresas_gvalid" name="Dados válidos?">
      <bpmn:incoming>Flow_02_Empresas_6</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_Empresas_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Node_02_Empresas_erro" name="Solicitar correções">
      <bpmn:incoming>Flow_02_Empresas_7</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Node_02_Empresas_cancel" name="Cadastro não alterado">
      <bpmn:incoming>Flow_02_Empresas_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_02_Empresas_dup" name="Sistema: verificar CNPJ único">
      <bpmn:incoming>Flow_02_Empresas_9</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_02_Empresas_gdup" name="Duplicidade encontrada?">
      <bpmn:incoming>Flow_02_Empresas_10</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_02_Empresas_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_02_Empresas_duperr" name="Rejeitar duplicidade">
      <bpmn:incoming>Flow_02_Empresas_11</bpmn:incoming>
    </bpmn:endEvent>
