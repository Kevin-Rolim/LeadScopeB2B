      <bpmn:outgoing>Flow_02_Empresas_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_02_Empresas_end" name="Empresa mantida com sucesso">
      <bpmn:incoming>Flow_02_Empresas_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_02_Empresas_0" sourceRef="Node_02_Empresas_s" targetRef="Node_02_Empresas_perm" />
