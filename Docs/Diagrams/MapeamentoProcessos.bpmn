      <bpmn:outgoing>Flow_04_Vinculos_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_04_Vinculos_okg" name="Integridade preservada?">
      <bpmn:incoming>Flow_04_Vinculos_11</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_04_Vinculos_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_04_Vinculos_err" name="Negar duplicidade / inconsistência">
      <bpmn:incoming>Flow_04_Vinculos_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_04_Vinculos_save" name="Sistema: inserir ou atualizar PESSOAS_EMPRESAS">
      <bpmn:incoming>Flow_04_Vinculos_13</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_04_Vinculos_aud" name="Sistema: registrar LOGS">
      <bpmn:incoming>Flow_04_Vinculos_14</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Vinculos_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_04_Vinculos_end" name="Lead contextualizado disponível">
      <bpmn:incoming>Flow_04_Vinculos_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_04_Vinculos_0" sourceRef="Node_04_Vinculos_s" targetRef="Node_04_Vinculos_auth" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_1" sourceRef="Node_04_Vinculos_auth" targetRef="Node_04_Vinculos_g" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_2" name="Não" sourceRef="Node_04_Vinculos_g" targetRef="Node_04_Vinculos_deny" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_3" name="Sim" sourceRef="Node_04_Vinculos_g" targetRef="Node_04_Vinculos_find" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_4" sourceRef="Node_04_Vinculos_find" targetRef="Node_04_Vinculos_exist" />
