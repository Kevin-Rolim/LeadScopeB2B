  <bpmn:process id="Process_13_Privacidade" name="13 • Bloqueio, remoção lógica e proteção de dados" isExecutable="false">
    <bpmn:documentation>RN-010; RNF-PRI-001; LGPD. Bloqueio/remoção preserva registros históricos e restringe busca e exportação.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_13_Privacidade">
      <bpmn:lane id="Lane_13_Privacidade_0" name="Usuário">
        <bpmn:flowNodeRef>Node_13_Privacidade_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_13_Privacidade_1" name="Revisor" />
      <bpmn:lane id="Lane_13_Privacidade_2" name="Administrador">
        <bpmn:flowNodeRef>Node_13_Privacidade_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_den</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_hide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_13_Privacidade_log</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_13_Privacidade_s" name="Identificar cadastro a bloquear/remover">
      <bpmn:outgoing>Flow_13_Privacidade_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Node_13_Privacidade_send" name="Solicitar bloqueio ou correção de dados">
      <bpmn:incoming>Flow_13_Privacidade_0</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_13_Privacidade_recv" name="Receber demanda e verificar autorização">
      <bpmn:incoming>Flow_13_Privacidade_1</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_13_Privacidade_auth" name="Sistema: verificar permissões e referências">
      <bpmn:incoming>Flow_13_Privacidade_2</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_13_Privacidade_g" name="Solicitação válida?">
      <bpmn:incoming>Flow_13_Privacidade_3</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_13_Privacidade_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_13_Privacidade_den" name="Registrar recusa fundamentada">
      <bpmn:incoming>Flow_13_Privacidade_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_13_Privacidade_choose" name="Decidir bloqueio, inativação ou correção">
      <bpmn:incoming>Flow_13_Privacidade_5</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_13_Privacidade_save" name="Sistema: aplicar marcação lógica e preservar histórico">
      <bpmn:incoming>Flow_13_Privacidade_6</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_13_Privacidade_hide" name="Sistema: impedir uso indevido em pesquisa/exportação">
      <bpmn:incoming>Flow_13_Privacidade_7</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Node_13_Privacidade_log" name="Sistema: registrar ação em LOGS">
      <bpmn:incoming>Flow_13_Privacidade_8</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_13_Privacidade_notice" name="Consultar resultado da solicitação">
      <bpmn:incoming>Flow_13_Privacidade_9</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Privacidade_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_13_Privacidade_end" name="Dados protegidos">
      <bpmn:incoming>Flow_13_Privacidade_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_13_Privacidade_0" sourceRef="Node_13_Privacidade_s" targetRef="Node_13_Privacidade_send" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_1" sourceRef="Node_13_Privacidade_send" targetRef="Node_13_Privacidade_recv" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_2" sourceRef="Node_13_Privacidade_recv" targetRef="Node_13_Privacidade_auth" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_3" sourceRef="Node_13_Privacidade_auth" targetRef="Node_13_Privacidade_g" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_4" name="Não" sourceRef="Node_13_Privacidade_g" targetRef="Node_13_Privacidade_den" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_5" name="Sim" sourceRef="Node_13_Privacidade_g" targetRef="Node_13_Privacidade_choose" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_6" sourceRef="Node_13_Privacidade_choose" targetRef="Node_13_Privacidade_save" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_7" sourceRef="Node_13_Privacidade_save" targetRef="Node_13_Privacidade_hide" />
    <bpmn:sequenceFlow id="Flow_13_Privacidade_8" sourceRef="Node_13_Privacidade_hide" targetRef="Node_13_Privacidade_log" />
