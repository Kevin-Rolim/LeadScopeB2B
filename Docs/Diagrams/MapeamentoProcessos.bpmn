        <bpmn:flowNodeRef>Node_04_Vinculos_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_04_Vinculos_1" name="Revisor" />
      <bpmn:lane id="Lane_04_Vinculos_2" name="Administrador" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_04_Vinculos_s" name="Selecionar Pessoa e Empresa">
