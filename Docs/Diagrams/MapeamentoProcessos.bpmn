      <bpmn:documentation>Transação SQL Server. Inativação com status/data quando aplicável; preservar vínculos e trilha histórica.</bpmn:documentation>
      <bpmn:incoming>Flow_02_Empresas_12</bpmn:incoming>
      <bpmn:outgoing>Flow_02_Empresas_13</bpmn:outgoing>
