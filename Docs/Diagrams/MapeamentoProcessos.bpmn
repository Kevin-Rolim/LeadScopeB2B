    <bpmn:sequenceFlow id="Flow_04_Vinculos_6" name="Sim" sourceRef="Node_04_Vinculos_exist" targetRef="Node_04_Vinculos_edit" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_7" sourceRef="Node_04_Vinculos_new" targetRef="Node_04_Vinculos_fields" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_8" sourceRef="Node_04_Vinculos_edit" targetRef="Node_04_Vinculos_fields" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_9" sourceRef="Node_04_Vinculos_fields" targetRef="Node_04_Vinculos_statuses" />
    <bpmn:sequenceFlow id="Flow_04_Vinculos_10" sourceRef="Node_04_Vinculos_statuses" targetRef="Node_04_Vinculos_check" />
