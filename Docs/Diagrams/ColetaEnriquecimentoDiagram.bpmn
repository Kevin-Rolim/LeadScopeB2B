<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_01" targetNamespace="https://leadscope.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:process id="Process_01" name="Coleta e Enriquecimento de Dados" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_01">
      <bpmn:lane id="Lane_LS" name="LeadScope B2B">
        <bpmn:flowNodeRef>Task_Mapear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0alt6qv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Normalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Canonico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Atualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AD" name="Adapter / Integração">
        <bpmn:flowNodeRef>Task_Consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Payload</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_US" name="Sistema">
        <bpmn:flowNodeRef>Start_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Fonte</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_01" name="Execução programada" />
    <bpmn:serviceTask id="Task_Fonte" name="Selecionar Fonte de Dados">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Consultar" name="Consultar API / dataset / site autorizado">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Payload" name="Receber payload bruto">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Mapear" name="Mapear campos conhecidos">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>Flow_17ecszc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Activity_0alt6qv" name="Criar DADOS_COLETADOS e vincular Fonte + Pessoa/Empresa">
      <bpmn:incoming>Flow_17ecszc</bpmn:incoming>
      <bpmn:outgoing>Flow_0yxahfs</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Normalizar" name="Normalizar valores quando houver regra">
      <bpmn:incoming>Flow_0yxahfs</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Canonico" name="Mapeamento e validação permitem aplicar valor canônico?" />
    <bpmn:task id="Task_Atualizar" name="Atualizar atributo canônico permitido" />
    <bpmn:task id="Task_Log" name="Registrar auditoria quando aplicável" />
    <bpmn:endEvent id="End_01" name="Dados registrados / normalizados" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start_01" targetRef="Task_Fonte" />
    <bpmn:sequenceFlow id="F02" sourceRef="Task_Fonte" targetRef="Task_Consultar" />
    <bpmn:sequenceFlow id="F03" sourceRef="Task_Consultar" targetRef="Task_Payload" />
    <bpmn:sequenceFlow id="F04" sourceRef="Task_Payload" targetRef="Task_Mapear" />
    <bpmn:sequenceFlow id="Flow_17ecszc" sourceRef="Task_Mapear" targetRef="Activity_0alt6qv" />
    <bpmn:sequenceFlow id="Flow_0yxahfs" sourceRef="Activity_0alt6qv" targetRef="Task_Normalizar" />
    <bpmn:sequenceFlow id="F07" sourceRef="Task_Normalizar" targetRef="Gateway_Canonico" />
    <bpmn:sequenceFlow id="F08" name="Sim" sourceRef="Gateway_Canonico" targetRef="Task_Atualizar" />
    <bpmn:sequenceFlow id="F10" name="Não" sourceRef="Gateway_Canonico" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="F09" sourceRef="Task_Atualizar" targetRef="Task_Log" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Log" targetRef="End_01" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_Process_01">
    <bpmn:participant id="Participant_Process_01" name="LeadScope B2B — Coleta e Enriquecimento" processRef="Process_01" />
