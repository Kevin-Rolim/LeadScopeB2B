<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Process_02" targetNamespace="https://leadscope.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:process id="Process_02" name="Pesquisa, Revisão e Exportação" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_02">
      <bpmn:lane id="Lane_Reviewer" name="Revisor">
        <bpmn:flowNodeRef>Task_Analisa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="LeadScope B2B">
        <bpmn:flowNodeRef>Task_Consulta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegRev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CriaExp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Arquivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Log2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Usuário">
        <bpmn:flowNodeRef>Start_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Criterios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Seleciona</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicExp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_02" name="Iniciar pesquisa" />
    <bpmn:userTask id="Task_Criterios" name="Informar critérios de pesquisa">
      <bpmn:incoming>G01</bpmn:incoming>
      <bpmn:outgoing>G02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Consulta" name="Consultar Empresas, Pessoas, vínculos, CNAEs e dados complementares">
      <bpmn:incoming>G02</bpmn:incoming>
      <bpmn:outgoing>G03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Analisa" name="Analisar vínculo / lead e evidências">
      <bpmn:incoming>G05</bpmn:incoming>
      <bpmn:outgoing>G06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Seleciona" name="Selecionar leads Pessoa-Empresa">
      <bpmn:incoming>G03</bpmn:incoming>
      <bpmn:outgoing>G04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Rev" name="Revisão necessária?" />
    <bpmn:serviceTask id="Task_RegRev" name="Registrar REVISOES e atualizar status quando aplicável">
      <bpmn:incoming>G06</bpmn:incoming>
      <bpmn:outgoing>G07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SolicExp" name="Solicitar exportação">
      <bpmn:incoming>G07</bpmn:incoming>
      <bpmn:incoming>G08</bpmn:incoming>
      <bpmn:outgoing>G09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CriaExp" name="Criar EXPORTACOES e associar pares selecionados">
      <bpmn:incoming>G09</bpmn:incoming>
      <bpmn:outgoing>G10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Arquivo" name="Gerar arquivo">
      <bpmn:incoming>G10</bpmn:incoming>
      <bpmn:outgoing>G11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Log2" name="Registrar operação em LOGS">
      <bpmn:incoming>G11</bpmn:incoming>
      <bpmn:outgoing>G12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_02" name="Exportação concluída" />
    <bpmn:sequenceFlow id="G01" sourceRef="Start_02" targetRef="Task_Criterios" />
    <bpmn:sequenceFlow id="G02" sourceRef="Task_Criterios" targetRef="Task_Consulta" />
    <bpmn:sequenceFlow id="G03" sourceRef="Task_Consulta" targetRef="Task_Seleciona" />
    <bpmn:sequenceFlow id="G05" name="Sim" sourceRef="Gateway_Rev" targetRef="Task_Analisa" />
    <bpmn:sequenceFlow id="G06" sourceRef="Task_Analisa" targetRef="Task_RegRev" />
    <bpmn:sequenceFlow id="G04" sourceRef="Task_Seleciona" targetRef="Gateway_Rev" />
    <bpmn:sequenceFlow id="G08" name="Não" sourceRef="Gateway_Rev" targetRef="Task_SolicExp" />
    <bpmn:sequenceFlow id="G07" sourceRef="Task_RegRev" targetRef="Task_SolicExp" />
    <bpmn:sequenceFlow id="G09" sourceRef="Task_SolicExp" targetRef="Task_CriaExp" />
    <bpmn:sequenceFlow id="G10" sourceRef="Task_CriaExp" targetRef="Task_Arquivo" />
    <bpmn:sequenceFlow id="G11" sourceRef="Task_Arquivo" targetRef="Task_Log2" />
    <bpmn:sequenceFlow id="G12" sourceRef="Task_Log2" targetRef="End_02" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_Process_02">
    <bpmn:participant id="Participant_Process_02" name="LeadScope B2B — Pesquisa, Revisão e Exportação" processRef="Process_02" />
  </bpmn:collaboration>
