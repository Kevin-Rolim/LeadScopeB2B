@model PerfilViewModel
@{ ViewData["Title"] = "Meu perfil"; }
<div class="account-form">
<h1 class="page-title">Meu perfil</h1>
<p>Perfil de acesso: <strong>@Model.PerfilAcesso</strong></p>
<form asp-action="Perfil" method="post" class="surface form-surface gap-2">
    <div asp-validation-summary="ModelOnly" class="text-destructive" role="alert"></div>
    <label asp-for="Nome" class="field-label"></label><input asp-for="Nome" class="input" autocomplete="name" /><span asp-validation-for="Nome" class="text-destructive"></span>
    <label asp-for="Email" class="field-label"></label><input asp-for="Email" class="input" autocomplete="email" /><span asp-validation-for="Email" class="text-destructive"></span>
    <label asp-for="SenhaAtual" class="field-label"></label><input asp-for="SenhaAtual" class="input" autocomplete="current-password" /><span asp-validation-for="SenhaAtual" class="text-destructive"></span>
    <p class="text-xs text-muted-foreground mb-0">Confirme sua senha para salvar. Suas outras sessões serão encerradas.</p>
    <button class="button button-primary mt-2" type="submit">Salvar meus dados</button>
</form>
<a asp-action="AlterarSenha" class="button button-secondary mt-3">Alterar senha</a>
</div>
