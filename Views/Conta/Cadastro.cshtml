@model CadastroViewModel
@{ ViewData["Title"] = "Criar conta"; }
<div class="mx-auto" style="max-width: 520px">
<h1 class="h3">Criar conta</h1>
<p class="text-muted">Seu cadastro permite consultar empresas, pessoas, leads e CNAEs. Outras permissões são concedidas pelo administrador.</p>
<form asp-action="Cadastro" method="post" class="card card-body gap-2">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" autocomplete="name" /><span asp-validation-for="Nome" class="text-danger"></span>
    <label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span>
    <label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control" autocomplete="new-password" /><span asp-validation-for="Senha" class="text-danger"></span>
    <label asp-for="ConfirmacaoSenha" class="form-label"></label><input asp-for="ConfirmacaoSenha" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmacaoSenha" class="text-danger"></span>
    <button class="btn btn-primary mt-2" type="submit">Criar conta</button>
</form>
<p class="mt-3">Já possui cadastro? <a asp-action="Login">Entrar</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
