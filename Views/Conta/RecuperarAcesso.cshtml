@model RecuperarAcessoViewModel
@{ ViewData["Title"] = "Recuperar acesso"; }
<div class="mx-auto" style="max-width: 520px">
<h1 class="h3">Recuperar acesso</h1>
@if(ViewData["RecuperacaoDisponivel"] is true) {
    <p>Informe o e-mail do seu cadastro para solicitar instruções de recuperação.</p>
    <form asp-action="RecuperarAcesso" method="post" class="card card-body gap-2">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span>
        <button class="btn btn-primary mt-2" type="submit">Solicitar recuperação</button>
    </form>
} else {
    <div class="alert alert-warning" role="status">@LeadScopeB2B.Services.RecuperacaoAcessoService.MensagemIndisponivel</div>
}
<p class="mt-3"><a asp-action="Login">Voltar para entrar</a> · <a asp-action="Cadastro">Criar conta</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
