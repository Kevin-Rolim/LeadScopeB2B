@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; }
<h1 class="page-title">Entrar</h1>
<p class="text-muted-foreground">Acesse com suas credenciais corporativas.</p>
@if(!string.IsNullOrWhiteSpace(Model.ReturnUrl)) { <p class="notice notice-warning mt-4">Entre para continuar. Se sua sessão expirou, informe suas credenciais novamente.</p> }
<form asp-action="Login" method="post" class="mt-5">
<input asp-for="ReturnUrl" type="hidden" />
<div asp-validation-summary="ModelOnly" class="mb-4" role="alert"></div>
<div class="space-y-4">
<div><label asp-for="Email" class="field-label">E-mail</label><input asp-for="Email" class="input" autocomplete="username" placeholder="nome@empresa.com.br" /><span asp-validation-for="Email"></span></div>
<div><label asp-for="Senha" class="field-label"></label><input asp-for="Senha" class="input" autocomplete="current-password" /><span asp-validation-for="Senha"></span></div>
</div>
<div class="mt-2 text-right"><a asp-action="RecuperarAcesso" class="text-xs font-medium">Esqueci minha senha</a></div>
<button class="button button-primary w-full mt-5" type="submit">Entrar</button>
</form>
<p class="mt-6 text-xs text-muted-foreground">Ainda não possui conta? <a asp-action="Cadastro" class="font-medium">Criar conta</a></p>
