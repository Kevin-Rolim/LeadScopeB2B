@model LoginViewModel
@{ ViewData["Title"] = "Entrar"; }
<div class="mx-auto" style="max-width: 520px">
<h1 class="h3">Entrar no LeadScopeB2B</h1>
<form asp-action="Login" method="post" class="card card-body gap-2">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="text-danger"></span>
    <label asp-for="Senha" class="form-label"></label><input asp-for="Senha" class="form-control" autocomplete="current-password" /><span asp-validation-for="Senha" class="text-danger"></span>
    <button class="btn btn-primary mt-2" type="submit">Entrar</button>
</form>
<p class="mt-3">Ainda não possui conta? <a asp-action="Cadastro">Criar conta</a></p>
<p><a asp-action="RecuperarAcesso">Esqueci minha senha</a></p>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
