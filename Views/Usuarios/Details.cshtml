@model UsuarioDetailsViewModel
@{
    ViewData["Title"] = "Detalhes do usuário";
}

<h1 class="page-title">Detalhes do usuário</h1>

<dl class="detail-list mt-3">
    <dt class="detail-label">Nome</dt>
    <dd class="detail-value">@Model.Nome</dd>
    <dt class="detail-label">E-mail</dt>
    <dd class="detail-value">@Model.Email</dd>
    <dt class="detail-label">Perfil de acesso</dt>
    <dd class="detail-value">@Model.PerfilAcesso</dd>
</dl>

@if(User.IsInRole("ADMIN")) { <a data-panel asp-action="Edit" asp-route-id="@Model.Id" class="button button-primary">Editar</a> }
<a asp-action="Index" class="button button-secondary">Voltar</a>
