@model IReadOnlyList<UsuarioListViewModel>
@{
    ViewData["Title"] = "Usuários";
}

<header class="page-header"><div><h1 class="page-title">Usuários</h1><p>Gerencie os usuários e atribua seus perfis de acesso.</p></div><div class="flex gap-2">
@if(User.IsInRole("ADMIN")) { <a data-panel asp-action="Create" class="button button-primary"><partial name="_Icon" model='"plus"' />Cadastrar usuário</a> }
</div></header>
<section class="surface overflow-hidden">
@if(Model.Count > 0) {
<div class="table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Perfil</th>
                <th class="text-right">Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Nome</td>
                <td>@usuario.Email</td>
                <td>@usuario.PerfilAcesso</td>
                <td class="text-right">
                    <a data-panel asp-action="Details" asp-route-id="@usuario.Id" class="button button-sm button-secondary"><partial name="_Icon" model='"eye"' />Detalhes</a>
                    @if(User.IsInRole("ADMIN")) { <a data-panel asp-action="Edit" asp-route-id="@usuario.Id" class="button button-sm button-secondary">Editar</a> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

}
@if (Model.Count == 0) { <partial name="_EmptyState" model='new EmptyState("Nenhum registro encontrado", "Cadastre um registro ou ajuste os filtros de pesquisa.", "users")' /> }
<footer class="surface-footer">Exibindo <span class="font-mono text-foreground">@Model.Count</span> usuários nesta consulta</footer></section>
