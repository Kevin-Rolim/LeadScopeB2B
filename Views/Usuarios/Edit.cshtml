@model UsuarioEditViewModel
@{
    ViewData["Title"] = "Editar usuário";
}

<h1 class="page-title">Editar usuário</h1>
<p class="text-muted-foreground">Deixe a nova senha vazia para manter a senha atual.</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="surface form-surface">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-destructive mb-3"></div>

    <div class="form-grid gap-3">
        <div class="field-half">
            <label asp-for="Nome" class="field-label"></label>
            <input asp-for="Nome" class="input" />
            <span asp-validation-for="Nome" class="text-destructive"></span>
        </div>
        <div class="field-half">
            <label asp-for="Email" class="field-label"></label>
            <input asp-for="Email" class="input" />
            <span asp-validation-for="Email" class="text-destructive"></span>
        </div>
        <div class="field-half">
            <label asp-for="NovaSenha" class="field-label"></label>
            <input asp-for="NovaSenha" class="input" />
            <span asp-validation-for="NovaSenha" class="text-destructive"></span>
        </div>
        <div class="field-half">
            <label asp-for="PerfilAcessoId" class="field-label"></label>
            <select asp-for="PerfilAcessoId" class="input">
                @foreach (var perfil in Model.PerfisDisponiveis)
                {
                    <option value="@perfil.Id">@perfil.Nome</option>
                }
            </select>
            <span asp-validation-for="PerfilAcessoId" class="text-destructive"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="button button-primary">Salvar alterações</button>
        <a asp-action="Index" class="button button-secondary">Cancelar</a>
    </div>
</form>
