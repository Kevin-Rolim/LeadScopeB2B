@model PessoaFormViewModel

<div class="form-grid gap-3">
    <div class="field-half">
        <label asp-for="Nome" class="field-label"></label>
        <input asp-for="Nome" class="input" />
        <span asp-validation-for="Nome" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="Email" class="field-label"></label>
        <input asp-for="Email" class="input" />
        <span asp-validation-for="Email" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="Telefone" class="field-label"></label>
        <input asp-for="Telefone" class="input" />
        <span asp-validation-for="Telefone" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="UrlLinkedIn" class="field-label"></label>
        <input asp-for="UrlLinkedIn" class="input" />
        <span asp-validation-for="UrlLinkedIn" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="Status" class="field-label"></label>
        <select asp-for="Status" class="input"><option value="PENDENTE">Em verificação</option><option value="VALIDADO">Validado</option></select>
        <span asp-validation-for="Status" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="Origem" class="field-label"></label>
        <input asp-for="Origem" class="input" />
        <span asp-validation-for="Origem" class="text-destructive"></span>
    </div>
</div>
