@model IReadOnlyList<PessoaListViewModel>
@{
    ViewData["Title"] = "Pessoas";
}

<header class="page-header"><div><h1 class="page-title">Pessoas</h1><p>Mantenha os contatos, sua origem e a situação cadastral.</p></div><div class="flex gap-2">
@if(User.IsInRole("ADMIN") || User.IsInRole("USUARIO")) { <a asp-controller="Importacao" asp-action="Index" class="button button-secondary"><partial name="_Icon" model='"upload"' />Importar CSV</a><a data-panel asp-action="Create" class="button button-primary"><partial name="_Icon" model='"plus"' />Cadastrar pessoa</a> }
</div></header>
<section class="surface overflow-hidden"><partial name="_Filtros" />
@if(Model.Count > 0) {
<div class="table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Contato</th>
                <th>Origem</th>
                <th>Status</th>
                <th class="text-right">Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var pessoa in Model)
        {
            <tr>
                <td>@pessoa.Nome</td>
                <td>
                    <div>@(pessoa.Email ?? "—")</div>
                    <div class="text-xs text-muted-foreground">@pessoa.Telefone</div>
                </td>
                <td>@(pessoa.Origem ?? "—")</td>
                <td>
                    <partial name="_Status" model='(pessoa.Status ?? "")' />
                    @if (pessoa.Bloqueada)
                    {
                        <span class="status status-warning">Bloqueada</span>
                    }
                </td>
                <td class="text-right">
                    <a data-panel asp-action="Details" asp-route-id="@pessoa.Id" class="button button-sm button-secondary"><partial name="_Icon" model='"eye"' />Detalhes</a>
                    @if(User.IsInRole("ADMIN") || User.IsInRole("USUARIO")) { <a data-panel asp-action="Edit" asp-route-id="@pessoa.Id" class="button button-sm button-secondary">Editar</a> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

}
@if (Model.Count == 0) { <partial name="_EmptyState" model='new EmptyState("Nenhum registro encontrado", "Cadastre um registro ou ajuste os filtros de pesquisa.", "users")' /> }
<footer class="surface-footer">Exibindo <span class="font-mono text-foreground">@Model.Count</span> pessoas nesta consulta</footer></section>
