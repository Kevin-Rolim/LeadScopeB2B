@model PessoaDetailsViewModel
@{
    ViewData["Title"] = "Remover pessoa";
}

<h1 class="page-title">Remover pessoa</h1>
<div class="notice notice-warning">
    Confirma a remoção de <strong>@Model.Nome</strong>? O registro será desativado e não aparecerá mais nas listagens.
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="button button-danger">Confirmar remoção</button>
    <a data-panel asp-action="Details" asp-route-id="@Model.Id" class="button button-secondary">Cancelar</a>
</form>
