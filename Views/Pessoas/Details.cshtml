@model PessoaDetailsViewModel
@{
    ViewData["Title"] = "Detalhes da pessoa";
}

<div class="d-flex justify-content-between align-items-start">
    <div>
        <h1 class="h3">@Model.Nome</h1>
        <p class="text-muted">Contato coletado em @Model.DataColeta.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    @if (Model.DataBloqueio.HasValue)
    {
        <span class="badge text-bg-warning">Bloqueada</span>
    }
</div>

<dl class="row card card-body">
    <dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@(Model.Email ?? "—")</dd>
    <dt class="col-sm-3">Telefone</dt><dd class="col-sm-9">@(Model.Telefone ?? "—")</dd>
    <dt class="col-sm-3">LinkedIn</dt><dd class="col-sm-9">@(Model.UrlLinkedin ?? "—")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Status ?? "—")</dd>
    <dt class="col-sm-3">Origem</dt><dd class="col-sm-9">@(Model.Origem ?? "—")</dd>
</dl>

<div class="d-flex gap-2 flex-wrap">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <form asp-action="AlterarBloqueio" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="bloquear" value="@(!Model.DataBloqueio.HasValue ? "true" : "false")" />
        <button type="submit" class="btn btn-outline-warning">
            @(Model.DataBloqueio.HasValue ? "Desbloquear" : "Bloquear")
        </button>
    </form>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remover</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
