@model LeadDetailsViewModel
@{
    ViewData["Title"] = "Detalhes do lead";
}

<h1 class="h3">@Model.Pessoa</h1>
<p class="text-muted">Lead relacionado a @Model.Empresa</p>

<dl class="row card card-body">
    <dt class="col-sm-3">Cargo</dt><dd class="col-sm-9">@(Model.Cargo ?? "—")</dd>
    <dt class="col-sm-3">Departamento</dt><dd class="col-sm-9">@(Model.Departamento ?? "—")</dd>
    <dt class="col-sm-3">Senioridade</dt><dd class="col-sm-9">@(Model.Senioridade ?? "—")</dd>
    <dt class="col-sm-3">Status do vínculo</dt><dd class="col-sm-9">@(Model.StatusVinculo ?? "—")</dd>
    <dt class="col-sm-3">Status do lead</dt><dd class="col-sm-9">@(Model.StatusLead ?? "—")</dd>
    <dt class="col-sm-3">Nível de confiança</dt><dd class="col-sm-9">@(Model.NivelConfianca.HasValue ? $"{Model.NivelConfianca:0.##}%" : "—")</dd>
    <dt class="col-sm-3">Fonte</dt><dd class="col-sm-9">@(Model.FonteVinculo ?? "—")</dd>
    <dt class="col-sm-3">Última verificação</dt><dd class="col-sm-9">@(Model.DataVerificacao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="col-sm-3">Última revisão</dt><dd class="col-sm-9">@(Model.DataRevisao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
</dl>

<a asp-action="Edit" asp-route-pessoaId="@Model.PessoaId" asp-route-empresaId="@Model.EmpresaId" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
