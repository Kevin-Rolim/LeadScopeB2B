@model LeadDetailsViewModel
@{
    ViewData["Title"] = "Detalhes do lead";
}

<h1 class="page-title">@Model.Pessoa</h1>
<p class="text-muted-foreground">Lead relacionado a @Model.Empresa</p>

<dl class="detail-list">
    <dt class="detail-label">Cargo</dt><dd class="detail-value">@(Model.Cargo ?? "—")</dd>
    <dt class="detail-label">Departamento</dt><dd class="detail-value">@(Model.Departamento ?? "—")</dd>
    <dt class="detail-label">Senioridade</dt><dd class="detail-value">@(Model.Senioridade ?? "—")</dd>
    <dt class="detail-label">Status do vínculo</dt><dd class="detail-value"><partial name="_Status" model='(Model.StatusVinculo ?? "")' /></dd>
    <dt class="detail-label">Status do lead</dt><dd class="detail-value"><partial name="_Status" model='(Model.StatusLead ?? "")' /></dd>
    <dt class="detail-label">Nível de confiança</dt><dd class="detail-value"><partial name="_Confidence" model="Model.NivelConfianca" /></dd>
    <dt class="detail-label">Fonte</dt><dd class="detail-value">@(Model.FonteVinculo ?? "—")</dd>
    <dt class="detail-label">Última verificação</dt><dd class="detail-value">@(Model.DataVerificacao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
    <dt class="detail-label">Última revisão</dt><dd class="detail-value">@(Model.DataRevisao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
</dl>

@if(User.IsInRole("ADMIN") || User.IsInRole("USUARIO")) { <a data-panel asp-action="Edit" asp-route-pessoaId="@Model.PessoaId" asp-route-empresaId="@Model.EmpresaId" class="button button-primary">Editar</a> }
<a asp-action="Index" class="button button-secondary">Voltar</a>

<div class="mt-3 flex gap-2"><a asp-controller="Pessoas" asp-action="Details" asp-route-id="@Model.PessoaId">Ver pessoa</a><a asp-controller="Empresas" asp-action="Details" asp-route-id="@Model.EmpresaId">Ver empresa</a></div>
@if(User.IsInRole("ADMIN") || User.IsInRole("REVISOR")) {
<h2 id="revisao" class="section-title mt-4">Revisar lead</h2>
<form asp-action="Revisar" method="post" data-confirm="Confirmar esta revisão? A decisão será registrada no histórico com seu nome." class="surface form-surface gap-2">
<input name="pessoaId" value="@Model.PessoaId" type="hidden" /><input name="empresaId" value="@Model.EmpresaId" type="hidden" />
<fieldset class="space-y-2"><legend class="field-label mb-2">Decisão <span class="text-destructive">*</span></legend>
@foreach(var item in new[]{("QUALIFICADO", "Qualificar", "Contato válido e com potencial comercial.", "circle-check"), ("EM_ANALISE", "Manter em análise", "Faltam informações para decidir.", "clock"), ("REJEITADO", "Rejeitar", "Dados inválidos ou sem aderência.", "circle-x")}) {
<label class="decision-option"><input type="radio" name="decisao" value="@item.Item1" required /><partial name="_Icon" model="item.Item4" /><span><strong>@item.Item2</strong><small>@item.Item3</small></span></label>
}
</fieldset>
<label for="comentario">Comentário</label><textarea id="comentario" name="comentario" class="input" maxlength="2000"></textarea>
<button class="button button-primary self-start">Registrar revisão</button>
</form>
}
@if(User.IsInRole("ADMIN") || User.IsInRole("USUARIO")) {
<form asp-action="Excluir" method="post" asp-route-pessoaId="@Model.PessoaId" asp-route-empresaId="@Model.EmpresaId" data-confirm="Remover este lead da base ativa? O histórico será preservado." class="mt-3"><button class="button button-danger-outline">Remover lead</button></form>
}
<h2 class="section-title mt-4">Histórico de revisões</h2>
@if(Model.Revisoes.Count == 0) { <p class="text-sm text-muted-foreground">Nenhuma revisão registrada.</p> }
else { <ol class="timeline">@foreach(var r in Model.Revisoes) { <li><p><span class="font-medium">@Presentation.Status(r.Decisao)</span> <span class="text-muted-foreground">· @r.Usuarios.Nome</span></p><p class="font-mono text-xs text-muted-foreground">@(r.DataHora?.ToString("dd/MM/yyyy HH:mm") ?? "—") UTC</p>@if(!string.IsNullOrWhiteSpace(r.Comentario)) { <p class="timeline-comment">@r.Comentario</p> }</li> }</ol> }
