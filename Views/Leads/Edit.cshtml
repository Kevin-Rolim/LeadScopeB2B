@model LeadFormViewModel
@{
    ViewData["Title"] = "Editar lead";
    ViewData["Edicao"] = true;
}

<h1 class="page-title">Editar lead</h1><p>Salvar alterações reabre a análise e exige nova revisão para qualificar o lead.</p>

<form asp-action="Edit" asp-route-pessoaId="@Model.PessoaId" asp-route-empresaId="@Model.EmpresaId" method="post" class="surface form-surface mt-3">
    <div asp-validation-summary="ModelOnly" class="text-destructive mb-3"></div>
    <partial name="_FormFields" model="Model" view-data="ViewData" />
    <div class="form-actions">
        <button type="submit" class="button button-primary">Salvar alterações</button>
        <a asp-action="Index" class="button button-secondary">Cancelar</a>
    </div>
</form>
