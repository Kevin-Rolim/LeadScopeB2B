@model LeadFormViewModel
@{
    var edicao = ViewData["Edicao"] as bool? ?? false;
}

<div class="form-grid gap-3">
    <div class="field-half">
        <label asp-for="PessoaId" class="field-label"></label>
        @if (edicao)
        {
            <input asp-for="PessoaId" type="hidden" />
            <select asp-for="PessoaId" class="input" disabled>
                @foreach (var pessoa in Model.PessoasDisponiveis)
                {
                    <option value="@pessoa.Id">@pessoa.Nome</option>
                }
            </select>
        }
        else
        {
            <select asp-for="PessoaId" class="input">
                <option value="0">Selecione</option>
                @foreach (var pessoa in Model.PessoasDisponiveis)
                {
                    <option value="@pessoa.Id">@pessoa.Nome</option>
                }
            </select>
        }
        <span asp-validation-for="PessoaId" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="EmpresaId" class="field-label"></label>
        @if (edicao)
        {
            <input asp-for="EmpresaId" type="hidden" />
            <select asp-for="EmpresaId" class="input" disabled>
                @foreach (var empresa in Model.EmpresasDisponiveis)
                {
                    <option value="@empresa.Id">@(empresa.NomeFantasia ?? empresa.RazaoSocial)</option>
                }
            </select>
        }
        else
        {
            <select asp-for="EmpresaId" class="input">
                <option value="0">Selecione</option>
                @foreach (var empresa in Model.EmpresasDisponiveis)
                {
                    <option value="@empresa.Id">@(empresa.NomeFantasia ?? empresa.RazaoSocial)</option>
                }
            </select>
        }
        <span asp-validation-for="EmpresaId" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="Cargo" class="field-label"></label>
        <input asp-for="Cargo" class="input" />
        <span asp-validation-for="Cargo" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="Departamento" class="field-label"></label>
        <input asp-for="Departamento" class="input" />
        <span asp-validation-for="Departamento" class="text-destructive"></span>
    </div>
    <div class="field-third">
        <label asp-for="Senioridade" class="field-label"></label>
        <input asp-for="Senioridade" class="input" />
        <span asp-validation-for="Senioridade" class="text-destructive"></span>
    </div>
    <div class="field-third">
        <label asp-for="StatusLead" class="field-label"></label>
        <select asp-for="StatusLead" class="input"><option value="NOVO">Novo</option><option value="EM_ANALISE">Em análise</option></select><small class="text-muted-foreground">Qualificação e rejeição são feitas na revisão.</small>
        <span asp-validation-for="StatusLead" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="NivelConfianca" class="field-label"></label>
        <input asp-for="NivelConfianca" type="number" step="0.01" min="0" max="100" class="input" />
        <span asp-validation-for="NivelConfianca" class="text-destructive"></span>
    </div>
    <div class="field-half">
        <label asp-for="FonteVinculo" class="field-label"></label>
        <input asp-for="FonteVinculo" class="input" />
        <span asp-validation-for="FonteVinculo" class="text-destructive"></span>
    </div>
</div>
