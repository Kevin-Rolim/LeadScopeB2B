@model EmpresaFormViewModel
@{
    ViewData["Title"] = "Editar empresa";
}

<h1 class="h3">Editar empresa</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body mt-3">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <partial name="_FormFields" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Salvar alterações</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
