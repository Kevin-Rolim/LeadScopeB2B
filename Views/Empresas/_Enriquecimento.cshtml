@model EmpresaDetailsViewModel
<section class="card card-body my-3" id="enriquecimento">
<h2 class="h5">Enriquecimento de dados</h2>
<p role="status">@Model.Enriquecimento.Estado</p>
<p class="text-muted">Cadastrar a empresa não realiza uma consulta imediata. A consulta manual e a automação geram evidências para revisão, sem substituir dados aprovados.</p>
@if (User.IsInRole("ADMIN")) {
    @if (Model.Enriquecimento.Operacoes.Count == 0) {
        <p>Nenhuma API habilitada com mapeamento compatível. <a asp-controller="IntegracoesApis" asp-action="Index">Configurar integração</a>.</p>
    }
    @foreach(var op in Model.Enriquecimento.Operacoes) {
        <form asp-action="Enriquecer" asp-route-id="@Model.Id" method="post" class="border-top pt-2 mb-2" onsubmit="this.querySelector('button').disabled=true;this.querySelector('[role=status]').textContent='Consulta em andamento…';">
            <input type="hidden" name="integracaoId" value="@op.IntegracaoId" />
            <input type="hidden" name="operacaoId" value="@op.OperacaoId" />
            <strong>@op.Nome</strong>
            @if(op.Bloqueio is not null){ <p>@op.Bloqueio</p> }
            else {
                @if(op.CustoDesconhecido || op.Cobrada) {
                    <label class="d-block my-2"><input type="checkbox" name="autorizarConsumo" value="true" required /> @(op.CustoDesconhecido ? "O custo não foi informado pelo provedor. Autorizo esta consulta e eventual cobrança." : "Autorizo o consumo e o custo desta consulta conforme as condições da integração.")</label>
                }
                <button class="btn btn-primary mt-2">Enriquecer dados</button>
            }
            <span role="status" class="ms-2"></span>
        </form>
    }
} else { <p>Um administrador pode executar consultas externas. A revisão segue as permissões existentes.</p> }
@if (Model.Enriquecimento.UltimaExecucao is {} last) {
    <p class="small">Última execução: @last.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @last.OperacaoId · @last.Codigo · HTTP @(last.Status?.ToString() ?? "—") · @last.CamposExtraidos campos · @last.Evidencias evidências novas · @last.Duplicidades duplicidades evitadas.</p>
    @foreach(var aviso in last.Avisos) { <p class="small text-muted">@aviso</p> }
}
@if(Model.Enriquecimento.Evidencias.Count>0) {
    <div class="table-responsive"><table class="table"><thead><tr><th>Campo</th><th>Valor externo</th><th>Origem</th><th>Revisão</th></tr></thead><tbody>
    @foreach(var e in Model.Enriquecimento.Evidencias) {
        <tr><td>@e.Campo</td><td>@e.Valor</td><td>@e.Fonte</td><td>@e.Estado
        @if(e.Estado=="Pendente" && (User.IsInRole("ADMIN") || User.IsInRole("OPERACAO"))) { <a asp-controller="Integracoes" asp-action="Revisar" asp-route-id="@e.Id">Comparar e revisar</a> }
        </td></tr>
    }
    </tbody></table></div>
}
</section>
