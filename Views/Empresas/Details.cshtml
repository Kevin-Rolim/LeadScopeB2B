@model EmpresaDetailsViewModel
@{
    ViewData["Title"] = "Detalhes da empresa";
}

<h1 class="page-title">@(string.IsNullOrWhiteSpace(Model.NomeFantasia) ? Model.RazaoSocial : Model.NomeFantasia)</h1>
<p class="text-muted-foreground">@Model.RazaoSocial</p>

<dl class="detail-list">
    <dt class="detail-label">CNPJ</dt><dd class="detail-value">@(Model.Cnpj ?? "—")</dd>
    <dt class="detail-label">Segmento</dt><dd class="detail-value">@(Model.Segmento ?? "—")</dd>
    <dt class="detail-label">Porte</dt><dd class="detail-value">@(Model.Porte ?? "—")</dd>
    <dt class="detail-label">Localidade</dt><dd class="detail-value">@Model.Cidade @Model.Estado</dd>
    <dt class="detail-label">E-mail</dt><dd class="detail-value">@(Model.Email ?? "—")</dd>
    <dt class="detail-label">Telefone</dt><dd class="detail-value">@(Model.Telefone ?? "—")</dd>
    <dt class="detail-label">Site</dt><dd class="detail-value">@(Model.UrlSite ?? "—")</dd>
    <dt class="detail-label">Status</dt><dd class="detail-value"><partial name="_Status" model='(Model.Status ?? "")' /></dd>
    <dt class="detail-label">Atualizada em</dt><dd class="detail-value">@(Model.DataAtualizacao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>
</dl>

@if(User.IsInRole("ADMIN") || User.IsInRole("USUARIO")) { <a data-panel asp-action="Edit" asp-route-id="@Model.Id" class="button button-primary">Editar</a> }
<a asp-action="Index" class="button button-secondary">Voltar</a>

<a asp-controller="Leads" asp-action="Index" asp-route-empresaId="@Model.Id" class="button button-secondary">Ver leads desta empresa</a>
<h2 class="section-title mt-4">CNAEs da empresa</h2>
@if(Model.Cnaes.Count == 0) { <p class="rounded-sm border border-dashed p-4 text-sm text-muted-foreground">Nenhum CNAE associado a esta empresa.</p> }
else { <ul class="surface divide-y">@foreach(var item in Model.Cnaes) { <li class="px-3 py-3"><code>@item.CnaeNumero</code><span class="block text-xs text-muted-foreground">@item.Cnaes.Descricao</span></li> }</ul> }
