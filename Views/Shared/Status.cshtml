@model LeadScopeB2B.Security.StatusPageModel
@{ ViewData["Title"] = Model.Title; }
<section class="error-page"><div class="empty-icon"><partial name="_Icon" model='"circle-alert"' /></div><p class="font-mono text-xs text-muted-foreground mb-2">HTTP @Model.Code</p><h1 class="page-title">@Model.Title</h1><p class="text-muted-foreground">@Model.Message</p>@if(Model.Reference is string reference) { <p class="text-xs text-muted-foreground mt-3">Referência: <code>@reference</code></p> }<div class="flex gap-2 mt-6"><a asp-controller="Home" asp-action="Index" class="button button-primary">Voltar ao início</a><a asp-controller="Conta" asp-action="Login" class="button button-secondary">Entrar</a></div></section>
