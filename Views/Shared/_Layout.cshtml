@{ var signedIn = User.Identity?.IsAuthenticated == true; }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light" />
<title>@ViewData["Title"] — LeadScopeB2B</title>
<link rel="icon" type="image/svg+xml" href="~/icons/favicon.svg" />
<link rel="preload" href="~/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
@if(signedIn) {
<partial name="_Sidebar" />
<div class="app-main"><header class="mobile-header"><button type="button" class="icon-button" data-menu-open aria-label="Abrir menu" aria-controls="sidebar" aria-expanded="false"><partial name="_Icon" model='"menu"' /></button><partial name="_Logo" model="false" /></header>
<main id="main-content" class="page-content" data-page-content tabindex="-1">@RenderBody()</main></div>
} else {
<div class="auth-layout"><partial name="_AuthStory" /><section class="auth-form-area"><main id="main-content" class="auth-content" data-page-content tabindex="-1"><div class="auth-mobile-brand"><partial name="_Logo" model="false" /></div>@RenderBody()</main></section></div>
}
<partial name="_Notifications" /><partial name="_Dialogs" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
