<dialog id="confirm-dialog" class="modal" aria-labelledby="confirm-title" aria-describedby="confirm-description">
<div class="modal-content"><h2 id="confirm-title" class="modal-title">Confirmar operação</h2><p id="confirm-description" class="mt-2 text-muted-foreground"></p></div>
<div class="modal-footer"><button type="button" class="button button-secondary" data-confirm-cancel>Cancelar</button><button type="button" class="button button-danger" data-confirm-accept>Confirmar</button></div>
</dialog>
<dialog id="side-panel" class="side-panel" aria-labelledby="panel-title">
<div class="panel-shell"><header class="panel-header"><h2 id="panel-title">Carregando…</h2><button type="button" class="icon-button" data-panel-close aria-label="Fechar painel"><partial name="_Icon" model='"x"' /></button></header><div id="panel-content" class="panel-body" aria-live="polite"></div></div>
</dialog>
