@model IReadOnlyList<LeadScopeB2B.Integration.Universal.ContratoApi>
@{ ViewData["Title"] = "Catálogo de APIs"; }
<h1 class="h3">Catálogo de APIs</h1>
<p>Contratos de referência baseados na documentação pública. Não representam parceria ou certificação oficial. Custos, permissões e limites do plano precisam de confirmação antes do uso.</p>
@foreach(var c in Model) {
<div class="card mb-3"><div class="card-body"><h2 class="h5">@c.Provedor</h2><p>@c.Categoria</p><p><a href="@c.Documentacao" rel="noopener noreferrer" target="_blank">Documentação do fornecedor</a></p>
<ul>@foreach(var op in c.Operacoes){<li>@op.Nome — @op.Metodo @op.Caminho; autenticação: @(op.AutenticacaoId == "" ? "sem autenticação" : c.Autenticacoes.Single(a=>a.Id==op.AutenticacaoId).Tipo)</li>}</ul>
<form asp-action="AdicionarCatalogo" method="post"><input type="hidden" name="provedor" value="@c.Provedor"/><button class="btn btn-outline-primary">Adicionar desabilitada</button></form>
</div></div>
}
<a asp-action="Index">Voltar ao gerenciador</a>
