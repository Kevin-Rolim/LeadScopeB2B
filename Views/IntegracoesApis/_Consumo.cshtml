@model LeadScopeB2B.ViewModels.Integracoes.ConfiguracaoApiForm
@{var uso=Model.Consumo; var endpoint=uso?.Endpoint; var headers=uso?.Headers; var caps=Model.Integracao.Contrato.Capacidades;}
<h2 class="h5">Consumo e limites</h2>
@if(endpoint is not null){
<p class="mb-1"><span class="badge text-bg-success">Confirmado pelo provedor</span> Atualizado em @endpoint.ObservadoEm.ToLocalTime().ToString("g")</p>
<dl class="row mb-2">
@if(endpoint.Competencia is not null){<dt class="col-sm-4">Competência informada</dt><dd class="col-sm-8">@endpoint.Competencia</dd>}
@if(endpoint.Limite.HasValue || endpoint.SemLimite){<dt class="col-sm-4">Cota @(endpoint.Competencia is null?"informada":"mensal")</dt><dd class="col-sm-8">@(endpoint.SemLimite?"Sem limite neste eixo":endpoint.Limite?.ToString())</dd>}
@if(endpoint.Usado.HasValue){<dt class="col-sm-4">Uso informado</dt><dd class="col-sm-8">@endpoint.Usado</dd>}
<dt class="col-sm-4">Saldo informado</dt><dd class="col-sm-8">@(endpoint.SemLimite?"Sem limite neste eixo":endpoint.Restante?.ToString()??"Não informado") @endpoint.Unidade</dd>
<dt class="col-sm-4">Frequência informada</dt><dd class="col-sm-8">@(endpoint.Rpm.HasValue?$"{endpoint.Rpm}/minuto":"Não informada")</dd>
@if(endpoint.RenovaEm.HasValue){<dt class="col-sm-4">Renovação informada</dt><dd class="col-sm-8">@endpoint.RenovaEm.Value.ToLocalTime().ToString("g")</dd>}
else{<dt class="col-sm-4">Renovação</dt><dd class="col-sm-8">Não informada; o sistema consultará novamente, sem presumir horário ou fuso.</dd>}
</dl>
@if(!endpoint.SemLimite && uso!.RestanteProvedor != endpoint.Restante){<p class="small">Saldo conservador para novas consultas: @uso.RestanteProvedor. Esta projeção desconta tentativas locais desde a confirmação; não é uma nova leitura do provedor.</p>}
}else if(headers is not null){
<p><span class="badge text-bg-success">Confirmado nos headers</span> @(headers.Rpm.HasValue?$"{headers.Rpm}/minuto":"Janela informada pelo provedor") · saldo: @(headers.Restante?.ToString()??"Não informado").</p>
@if(headers.RenovaEm.HasValue){<p>Janela informada até @headers.RenovaEm.Value.ToLocalTime().ToString("g").</p>}
}else{
<p>Limites reais <strong>desconhecidos</strong>. @(caps.OperacaoCota!=""?"Disponíveis após conectar ao provedor.":"Esta API não declara descoberta de consumo suportada.")</p>
}
@if(caps.LimitesDeclarados.PorMinuto is { } rpm){<p><span class="badge text-bg-secondary">Documentado, não confirmado para a conta</span> @rpm/minuto · @caps.Documentacao</p>}
<p class="small text-muted">Política local de segurança: até @(Model.Plano.Sistema.PorMinuto??6) chamadas/minuto, @(Model.Plano.Sistema.Diario??20)/dia e @(Model.Plano.Sistema.Mensal??200)/mês. Não representa o plano contratado. O menor limite aplicável será respeitado.</p>
@if(uso?.BloqueadaAte > DateTimeOffset.UtcNow){<div class="alert alert-info">Consultas temporariamente suspensas até @uso.BloqueadaAte.ToLocalTime().ToString("g"). A retomada respeita a espera informada; 429 não identifica, por si só, cota mensal esgotada.</div>}
@if(uso?.ErroDescoberta is not null){<p class="text-warning">Não foi possível atualizar o consumo (@uso.ErroDescoberta). Os últimos dados conhecidos foram preservados.</p>}
