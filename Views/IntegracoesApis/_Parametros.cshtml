@model LeadScopeB2B.Integration.Universal.OperacaoApi
<h2 class="h5 mt-3">Parâmetros</h2>
<p class="small">Rota, query, header ou propriedade do corpo JSON. Credenciais devem usar a seção de autenticação. Valores fixos e origem do cadastro são opcionais.</p>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Nome</th><th>Local</th><th>Tipo</th><th>Formato</th><th>Obrigatório</th><th>Padrão</th><th>Origem no cadastro</th><th>Limites / enumeração</th><th></th></tr></thead><tbody id="parametros">
@for(var i=0;i<Model.Parametros.Count;i++) {var p=Model.Parametros[i];
<tr><td><input type="hidden" name="Operacao.Parametros.Index" value="@i"/><input class="form-control" name="Operacao.Parametros[@i].Nome" value="@p.Nome" required/></td>
<td><select class="form-select" name="Operacao.Parametros[@i].Local">@foreach(var v in new[]{"path","query","header","body"}){<option value="@v" selected="@(p.Local==v)">@v</option>}</select></td>
<td><select class="form-select" name="Operacao.Parametros[@i].Tipo">@foreach(var v in new[]{"string","integer","number","boolean","object","array"}){<option value="@v" selected="@(p.Tipo==v)">@v</option>}</select></td>
<td><select class="form-select" name="Operacao.Parametros[@i].Formato">@foreach(var v in new[]{"","cnpj","cnpjNumerico","email","uri"}){<option value="@v" selected="@(p.Formato==v)">@(v==""?"Padrão":v)</option>}</select></td>
<td><input type="checkbox" name="Operacao.Parametros[@i].Obrigatorio" value="true" checked="@p.Obrigatorio"/></td><td><input class="form-control" name="Operacao.Parametros[@i].Padrao" value="@p.Padrao"/></td>
<td><select class="form-select" name="Operacao.Parametros[@i].CampoOrigem"><option value="">Entrada manual</option>@foreach(var v in LeadScopeB2B.Integration.Universal.MapeadorApi.CamposOrigem){<option value="@v" selected="@(p.CampoOrigem==v)">@v</option>}</select></td>
<td><label class="small">Tamanho máximo<input class="form-control" type="number" name="Operacao.Parametros[@i].MaxComprimento" value="@p.MaxComprimento" min="1" max="65536"/></label><label class="small">Mínimo<input class="form-control" name="Operacao.Parametros[@i].Minimo" value="@p.Minimo"/></label><label class="small">Máximo<input class="form-control" name="Operacao.Parametros[@i].Maximo" value="@p.Maximo"/></label>
@foreach(var v in p.Valores){<input type="hidden" name="Operacao.Parametros[@i].Valores" value="@v"/>}
@if(p.Valores.Count>0){<small>@string.Join(", ",p.Valores)</small>}</td><td><button type="button" class="btn btn-sm btn-outline-danger" data-remover>Remover</button></td></tr>
}
</tbody></table></div><button type="button" class="btn btn-sm btn-outline-primary" data-adicionar="parametro">Adicionar parâmetro</button>
<template id="template-parametro"><tr><td><input type="hidden" name="Operacao.Parametros.Index" value="__i__"/><input class="form-control" name="Operacao.Parametros[__i__].Nome" required/></td>
<td><select class="form-select" name="Operacao.Parametros[__i__].Local"><option>query</option><option>path</option><option>header</option><option>body</option></select></td>
<td><select class="form-select" name="Operacao.Parametros[__i__].Tipo"><option>string</option><option>integer</option><option>number</option><option>boolean</option><option>object</option><option>array</option></select></td>
<td><select class="form-select" name="Operacao.Parametros[__i__].Formato"><option value="">Padrão</option><option>cnpj</option><option>cnpjNumerico</option><option>email</option><option>uri</option></select></td>
<td><input type="checkbox" name="Operacao.Parametros[__i__].Obrigatorio" value="true"/></td><td><input class="form-control" name="Operacao.Parametros[__i__].Padrao"/></td>
<td><select class="form-select" name="Operacao.Parametros[__i__].CampoOrigem"><option value="">Entrada manual</option>@foreach(var v in LeadScopeB2B.Integration.Universal.MapeadorApi.CamposOrigem){<option>@v</option>}</select></td>
<td><label class="small">Tamanho máximo<input class="form-control" type="number" name="Operacao.Parametros[__i__].MaxComprimento" value="2000" min="1" max="65536"/></label><label class="small">Mínimo<input class="form-control" name="Operacao.Parametros[__i__].Minimo"/></label><label class="small">Máximo<input class="form-control" name="Operacao.Parametros[__i__].Maximo"/></label></td>
<td><button type="button" class="btn btn-sm btn-outline-danger" data-remover>Remover</button></td></tr></template>
