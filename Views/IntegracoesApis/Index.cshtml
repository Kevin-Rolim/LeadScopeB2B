@model LeadScopeB2B.Integration.Universal.EstadoIntegracoes
@{ ViewData["Title"] = "Integrações e APIs"; var mes = DateTimeOffset.UtcNow.ToString("yyyy-MM"); }
<h1 class="h3">Integrações e APIs</h1>
<p>Conecte uma API, escolha as operações e ative a automação quando desejar. Credenciais são guardadas separadamente e nunca exibidas.</p>
<div class="d-flex gap-2 mb-3 flex-wrap"><a class="btn btn-primary" asp-action="Nova">Configurar REST manualmente</a><a class="btn btn-outline-primary" asp-action="Importar">Importar OpenAPI ou contrato privado</a><a class="btn btn-outline-primary" asp-action="Catalogo">Catálogo</a><a class="btn btn-outline-secondary" asp-controller="Integracoes" asp-action="Index">Revisar evidências</a></div>
<div class="table-responsive"><table class="table"><thead><tr><th>API</th><th>Conexão</th><th>Operações</th><th>Automação</th><th>Consumo identificado</th><th></th></tr></thead><tbody>
@foreach(var api in Model.Integracoes) {
 var uso = Model.Consumo.GetValueOrDefault(api.Id);
 var dados = uso?.Endpoint ?? uso?.Headers;
 <tr><td>@api.Contrato.Provedor</td><td>@api.EstadoConexao @if(!api.Habilitada){<small class="d-block text-muted">Desativada</small>} @if(uso?.BloqueadaAte > DateTimeOffset.UtcNow){<small class="d-block">Em espera até @uso.BloqueadaAte.ToLocalTime().ToString("g")</small>}</td>
 <td>@api.Contrato.Operacoes.Count(o=>o.Habilitada && o.ConsultaCota is null) ativas</td><td>@(api.Contrato.Operacoes.Any(o=>o.Rotina.Habilitada)?"Ativa":"Desativada")</td>
 <td>@(dados is null?"Limites desconhecidos; proteção local ativa":dados.SemLimite?"Sem limite no eixo informado":$"Saldo informado: {dados.Restante?.ToString()??"não disponível"}") @if(dados?.Rpm is { } rpm){<small class="d-block">Provedor: @rpm/minuto</small>}</td><td><a asp-action="Configurar" asp-route-id="@api.Id">Abrir conexão</a></td></tr>
}
</tbody></table></div>
@if(Model.Integracoes.Count==0){<p>Nenhuma integração cadastrada. O cadastro não realiza chamadas externas.</p>}
<details class="mt-4"><summary>Histórico e backup</summary>
<h2 class="h5 mt-4">Execuções e requisições recentes</h2>
<p class="small">Reservas conservadoras não representam a fatura do fornecedor. Histórico limitado aos últimos 2.000 eventos; totais de consumo são mantidos separadamente.</p>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Data UTC</th><th>Integração / operação</th><th>Usuário</th><th>Resultado</th><th>HTTP</th><th>Campos / evidências / duplicidades</th><th>Estimativa de custo</th></tr></thead><tbody>
@foreach(var h in Model.Historico.AsEnumerable().Reverse().Take(100)) {<tr><td>@h.Data.ToString("u")</td><td>@(Model.Integracoes.FirstOrDefault(a=>a.Id==h.IntegracaoId)?.Contrato.Provedor ?? h.IntegracaoId.ToString()) / @h.OperacaoId</td><td>@h.UsuarioId</td><td>@h.Codigo @if(h.Avisos.Count>0){<details><summary>Avisos de mapeamento</summary>@foreach(var aviso in h.Avisos){<p>@aviso</p>}</details>}</td><td>@h.Status</td><td>@h.CamposExtraidos / @h.Evidencias / @h.Duplicidades</td><td>@(h.CustoDesconhecido?"Desconhecido":h.Reserva.ToString())</td></tr>}
</tbody></table></div>
<form asp-action="Backup" method="post"><button class="btn btn-outline-secondary">Baixar backup de configurações e segredos criptografados</button></form>
<p class="small mt-2">A restauração é feita pelo operador, com a aplicação parada e as mesmas chaves de Data Protection. Veja Docs/MotorIntegracoes.md.</p>

</details>
