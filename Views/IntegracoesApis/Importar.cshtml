@{ ViewData["Title"]="Importar contrato de API"; var importacao=ViewBag.Importacao as LeadScopeB2B.Integration.Universal.ImportacaoApi; }
<h1 class="h3">Importar OpenAPI ou contrato privado</h1>
<p>JSON/YAML, OpenAPI 3.0/3.1 ou contrato LeadScopeB2B 1.0. Não são buscadas referências externas, scripts ou arquivos locais. Limite: 1 MiB. Toda operação é importada desabilitada.</p>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Importar" method="post" enctype="multipart/form-data">
<label class="form-label">Arquivo<input type="file" name="arquivo" class="form-control" accept=".json,.yaml,.yml"/></label>
<label class="form-label d-block">Ou cole o documento<textarea name="documento" class="form-control font-monospace" rows="12">@ViewBag.Documento</textarea></label>
<div class="row g-3"><div class="col-md-6"><label class="form-label">Perfil autorizado pelo servidor<select name="perfilRede" class="form-select">@foreach(string v in ViewBag.Redes){<option>@v</option>}</select></label></div>
<div class="col-md-6"><label class="form-label">Fonte para evidências<select name="fonteDadosId" class="form-select"><option value="0">Configurar depois</option>@foreach(FonteDados f in ViewBag.Fontes){<option value="@f.Id">@f.Nome</option>}</select></label></div></div>
<button name="salvar" value="false" class="btn btn-outline-primary">Validar e descobrir operações</button> <button name="salvar" value="true" class="btn btn-primary">Importar desabilitada</button>
</form>
@if(importacao is not null){
<h2 class="h5 mt-4">@importacao.Contrato.Provedor</h2><p>@importacao.Contrato.UrlBase</p>
<ul>@foreach(var aviso in importacao.Avisos){<li>@aviso</li>}</ul>
<table class="table"><thead><tr><th>Operação</th><th>Requisição</th><th>Autenticação</th><th>Compatibilidade</th></tr></thead><tbody>@foreach(var op in importacao.Contrato.Operacoes){<tr><td>@op.Id</td><td>@op.Metodo @op.Caminho</td><td>@(op.AutenticacaoId==""?"Nenhuma":op.AutenticacaoId)</td><td>@(op.Incompatibilidade ?? "REST/JSON suportado; revisar antes de ativar")</td></tr>}</tbody></table>
}
<a asp-action="Index">Voltar ao gerenciador</a>
