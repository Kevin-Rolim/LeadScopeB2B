@model LeadScopeB2B.ViewModels.Integracoes.NovaApiForm
@{ ViewData["Title"]="Nova integração REST"; }
<h1 class="h3">Nova integração REST/JSON</h1>
<p>Informe o endereço e a operação que deseja usar. Nenhuma consulta é feita ao cadastrar. A integração e suas operações começam desabilitadas.</p>
<div class="d-flex gap-3 mb-3"><a asp-action="Catalogo">Selecionar catálogo</a><a asp-action="Importar">Importar OpenAPI / contrato privado</a></div>
<form asp-action="Nova" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Contrato.UrlBase" class="form-label">Endereço da API</label><input asp-for="Contrato.UrlBase" class="form-control" required placeholder="https://api.exemplo.com/v1"/>
<details class="mt-2"><summary>Nome e acesso a redes privadas (opcionais)</summary><div class="mt-2"><label asp-for="Contrato.Provedor">Nome para identificar a conexão (se vazio, usamos o endereço)</label><input asp-for="Contrato.Provedor" class="form-control" maxlength="100"/>
<label asp-for="Contrato.PerfilRede">Perfil autorizado pelo servidor</label><select asp-for="Contrato.PerfilRede" class="form-select">@foreach(string v in ViewBag.Redes){<option>@v</option>}</select>
<label asp-for="Contrato.Documentacao">Documentação (opcional)</label><input asp-for="Contrato.Documentacao" class="form-control"/>
<label asp-for="FonteDadosId">Fonte existente (opcional; preparada pelo sistema ao conectar)</label><select asp-for="FonteDadosId" class="form-select"><option value="0">Gerenciar automaticamente</option>@foreach(FonteDados f in ViewBag.Fontes){<option value="@f.Id">@f.Nome</option>}</select>
</div></details>
<h2 class="h5 mt-4">Autenticação</h2>
<p class="small">Cadastre os segredos depois, na configuração protegida da integração. Não preencha chaves em parâmetros ou headers comuns.</p>
<div class="row g-3"><div class="col-md-4"><label asp-for="Autenticacao.Tipo">Método</label><select asp-for="Autenticacao.Tipo" class="form-select">@foreach(var v in new[]{"none","apiKeyHeader","apiKeyQuery","bearer","basic","clientCredentials","authorizationCode"}){<option>@v</option>}</select></div>
<div class="col-md-4" data-auth-mode="apiKeyHeader apiKeyQuery"><label asp-for="Autenticacao.Nome">Nome do header/query para API Key</label><input asp-for="Autenticacao.Nome" class="form-control"/></div>
<div class="col-md-4" data-auth-mode="clientCredentials authorizationCode"><label asp-for="Autenticacao.Escopos">Escopos OAuth</label><input asp-for="Autenticacao.Escopos" class="form-control"/></div>
<div class="col-md-6" data-auth-mode="clientCredentials authorizationCode"><label asp-for="Autenticacao.TokenUrl">Token endpoint HTTPS</label><input asp-for="Autenticacao.TokenUrl" class="form-control"/></div>
<div class="col-md-6" data-auth-mode="authorizationCode"><label asp-for="Autenticacao.AutorizacaoUrl">Authorization endpoint HTTPS (PKCE)</label><input asp-for="Autenticacao.AutorizacaoUrl" class="form-control"/></div>
<div class="col-md-4" data-auth-mode="clientCredentials authorizationCode"><label asp-for="Autenticacao.EnvioCliente">Autenticação do cliente OAuth</label><select asp-for="Autenticacao.EnvioCliente" class="form-select"><option>basic</option><option>body</option></select></div></div>
<h2 class="h5 mt-4">Primeira operação</h2><input type="hidden" asp-for="Operacao.Id" value="consulta"/>
<div class="row g-3"><div class="col-md-4"><label asp-for="Operacao.Nome">Nome</label><input asp-for="Operacao.Nome" class="form-control"/></div>
<div class="col-md-2"><label asp-for="Operacao.Metodo">Método</label><select asp-for="Operacao.Metodo" class="form-select">@foreach(var v in new[]{"GET","HEAD","OPTIONS","POST","PUT","PATCH","DELETE"}){<option>@v</option>}</select></div>
<div class="col-md-6"><label asp-for="Operacao.Caminho">Endpoint</label><input asp-for="Operacao.Caminho" class="form-control" required placeholder="/companies/{id}"/></div></div>
<details class="mt-3"><summary>Parâmetros adicionais</summary><p>Os parâmetros de rota entre chaves são identificados ao cadastrar.</p><partial name="_Parametros" model="Model.Operacao"/></details>
<details class="mt-3"><summary>Campos para o LeadScopeB2B (quando necessário)</summary><partial name="_Mapeamentos" model="Model.Operacao"/></details>
<button class="btn btn-primary mt-4">Continuar para conectar</button>
</form>
<datalist id="categorias">@foreach(var c in new[]{"Dados empresariais","Consultas cadastrais","Dados geográficos","Informações públicas governamentais","Enriquecimento empresarial","Validação de informações","Plataformas CRM","Serviços comerciais","Serviços de comunicação"}){<option>@c</option>}</datalist>
<a asp-action="Index">Voltar</a>
@section Scripts { <script src="~/js/integracoes-apis.js" asp-append-version="true"></script> }
