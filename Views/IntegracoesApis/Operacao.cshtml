@model LeadScopeB2B.ViewModels.Integracoes.OperacaoApiForm
@{ ViewData["Title"]="Operação e mapeamento"; }
<h1 class="h3">Operação · @Model.Integracao.Contrato.Provedor</h1>
<p>Permissões/escopos declarados pelo provedor: @(Model.Operacao.Permissoes.Count == 0 ? "não declarados" : string.Join(", ", Model.Operacao.Permissoes))</p>
<div asp-validation-summary="All" class="text-danger"></div>
@if(Model.Operacao.Incompatibilidade is string erro){<div class="alert alert-warning">Operação importada com recurso não suportado: @erro. Não pode ser habilitada automaticamente. Crie uma operação manual compatível ou desenvolva um adaptador.</div>}
<form asp-action="Operacao" method="post">
<input asp-for="Id" type="hidden"/><input asp-for="Revisao" type="hidden"/><input asp-for="Nova" type="hidden"/><input asp-for="Operacao.Incompatibilidade" type="hidden"/>
<div class="row g-3"><div class="col-md-4"><label asp-for="Operacao.Id">ID</label><input asp-for="Operacao.Id" class="form-control" readonly="@(!Model.Nova)" required/></div><div class="col-md-8"><label asp-for="Operacao.Nome">Nome</label><input asp-for="Operacao.Nome" class="form-control" required/></div>
<div class="col-md-2"><label asp-for="Operacao.Metodo">Método</label><select asp-for="Operacao.Metodo" class="form-select">@foreach(var v in new[]{"GET","HEAD","OPTIONS","POST","PUT","PATCH","DELETE"}){<option>@v</option>}</select></div><div class="col-md-6"><label asp-for="Operacao.Caminho">Endpoint</label><input asp-for="Operacao.Caminho" class="form-control" required/></div>
<div class="col-md-4"><label asp-for="Operacao.AutenticacaoId">Credencial exigida</label><select asp-for="Operacao.AutenticacaoId" class="form-select"><option value="">Sem autenticação</option>@foreach(var a in Model.Integracao.Contrato.Autenticacoes){<option value="@a.Id">@a.Id (@a.Tipo)</option>}</select></div>
<div class="col-md-4"><label asp-for="Operacao.TimeoutSegundos">Timeout em segundos</label><input asp-for="Operacao.TimeoutSegundos" type="number" min="1" max="120" class="form-control"/></div><div class="col-md-4"><label asp-for="Operacao.TentativasAdicionais">Retries extras somente para leituras seguras (0–2)</label><input asp-for="Operacao.TentativasAdicionais" type="number" min="0" max="2" class="form-control"/></div><div class="col-md-4"><label asp-for="Operacao.MaxItensPorPagina">Máximo de itens por página</label><input asp-for="Operacao.MaxItensPorPagina" type="number" min="1" max="1000" class="form-control"/></div></div>
<partial name="_Parametros" model="Model.Operacao"/><partial name="_Mapeamentos" model="Model.Operacao"/>
<h2 class="h5 mt-4">Paginação</h2>
<div class="row g-2"><div class="col"><label asp-for="Operacao.Paginacao.Tipo">Tipo</label><select asp-for="Operacao.Paginacao.Tipo" class="form-select"><option>none</option><option>page</option><option>offset</option><option>cursor</option></select></div><div class="col"><label asp-for="Operacao.Paginacao.Parametro">Parâmetro</label><input asp-for="Operacao.Paginacao.Parametro" class="form-control"/></div><div class="col"><label asp-for="Operacao.Paginacao.Inicio">Início</label><input asp-for="Operacao.Paginacao.Inicio" class="form-control" type="number" min="0"/></div><div class="col"><label asp-for="Operacao.Paginacao.Tamanho">Tamanho</label><input asp-for="Operacao.Paginacao.Tamanho" class="form-control" type="number" min="1"/></div><div class="col"><label asp-for="Operacao.Paginacao.MaxPaginas">Máximo de páginas</label><input asp-for="Operacao.Paginacao.MaxPaginas" class="form-control" type="number" min="1" max="100"/></div></div>
<label asp-for="Operacao.Paginacao.ParametroTamanho">Nome do parâmetro de tamanho (opcional)</label><input asp-for="Operacao.Paginacao.ParametroTamanho" class="form-control"/>
<label asp-for="Operacao.Paginacao.CaminhoProximoCursor">Caminho do próximo cursor (somente cursor)</label><input asp-for="Operacao.Paginacao.CaminhoProximoCursor" class="form-control"/>
<h2 class="h5 mt-4">Consumo e custos</h2><p class="small">Configuração opcional. Preencha 0 somente para custo conhecido como gratuito. Nenhum plano ou mensalidade é obrigatório para consultar. Vazio significa desconhecido. Por item, a reserva usa o máximo de itens por página; os valores não são uma fatura.</p>
<div class="row g-2"><div class="col"><label asp-for="Operacao.Custo.PorRequisicao">Por requisição</label><input asp-for="Operacao.Custo.PorRequisicao" type="number" min="0" step="0.000001" class="form-control"/></div><div class="col"><label asp-for="Operacao.Custo.PorItem">Por item</label><input asp-for="Operacao.Custo.PorItem" type="number" min="0" step="0.000001" class="form-control"/></div><div class="col"><label asp-for="Operacao.Custo.ReservaCustoDesconhecido">Reserva máxima se custo desconhecido</label><input asp-for="Operacao.Custo.ReservaCustoDesconhecido" type="number" min="0.000001" step="0.000001" class="form-control"/></div><div class="col"><label asp-for="Operacao.Custo.Unidade">Unidade de consumo</label><select asp-for="Operacao.Custo.Unidade" class="form-select"><option>requisicao</option><option>item</option><option>credito</option></select></div><div class="col"><label asp-for="Operacao.Custo.CreditosPorUnidade">Créditos por unidade</label><input asp-for="Operacao.Custo.CreditosPorUnidade" type="number" min="0" step="0.000001" class="form-control"/></div></div>
<h2 class="h5 mt-4">Automação</h2><p class="small">Ative a automação na tela de conexão. Rotinas técnicas antigas também podem usar a configuração do operador. Rotinas e operações começam desabilitadas. Escrita automática exige também autorização do servidor.</p>
<div class="row g-3"><div class="col"><label asp-for="Operacao.Rotina.UsuarioId">ID do administrador responsável</label><input asp-for="Operacao.Rotina.UsuarioId" type="number" class="form-control" min="1"/></div><div class="col"><label asp-for="Operacao.Rotina.IntervaloMinutos">Intervalo em minutos</label><input asp-for="Operacao.Rotina.IntervaloMinutos" type="number" min="1" max="43200" class="form-control"/></div><div class="col"><label asp-for="Operacao.Rotina.LimitePorExecucao">Limite de registros por execução</label><input asp-for="Operacao.Rotina.LimitePorExecucao" type="number" min="1" max="100" class="form-control"/></div></div>
<div class="row g-2 mt-1"><div class="col"><label asp-for="Operacao.Rotina.Criterio">Critério</label><select asp-for="Operacao.Rotina.Criterio" class="form-select"><option>parametrosFixos</option><option>empresasSemEvidencias</option><option>pessoasSemEvidencias</option><option>empresasAtivas</option><option>pessoasAtivas</option></select></div><div class="col"><label asp-for="Operacao.Rotina.PoliticaErros">Após falha individual</label><select asp-for="Operacao.Rotina.PoliticaErros" class="form-select"><option>continuar</option><option>parar</option></select></div></div>
@foreach(var p in Model.Operacao.Parametros.Where(p=>p.CampoOrigem=="")) {<label class="form-label d-block mt-2">Valor fixo da rotina: @p.Nome<input class="form-control" name="Operacao.Rotina.Parametros[@p.Nome]" value="@Model.Operacao.Rotina.Parametros.GetValueOrDefault(p.Nome)"/></label>}
@foreach(var property in new[]{"PersistirEvidencias","PermitirEscrita","AutorizarCusto","AutorizarCustoDesconhecido","Habilitada"}){
 var value = (bool)typeof(LeadScopeB2B.Integration.Universal.RotinaApi).GetProperty(property)!.GetValue(Model.Operacao.Rotina)!;
 <label class="d-block"><input type="checkbox" name="Operacao.Rotina.@property" value="true" checked="@value"/> Rotina: @property</label>
}
<h2 class="h5 mt-4">Teste de mapeamento sem chamar a API</h2>
<label asp-for="AmostraJson">Cole uma resposta JSON de exemplo</label><textarea asp-for="AmostraJson" rows="5" class="form-control font-monospace"></textarea>
<button class="btn btn-outline-primary mt-2" asp-action="Previa">Listar campos e testar mapeamento (sem requisição externa)</button>
<datalist id="caminhos-json">@foreach(var p in Model.CaminhosDisponiveis){<option>@p</option>}</datalist>
@if(Model.CaminhosDisponiveis.Count>0){<p class="mt-2">Caminhos detectados (também disponíveis na seleção de campo): @string.Join(", ",Model.CaminhosDisponiveis)</p>}
@if(Model.Previa is not null){<table class="table mt-2"><thead><tr><th>Destino</th><th>Valor normalizado</th></tr></thead><tbody>@foreach(var row in Model.Previa){foreach(var p in row){<tr><td>@p.Key</td><td>@p.Value</td></tr>}}</tbody></table>}
@foreach(var aviso in Model.Avisos){<p>@aviso</p>}
<details class="mt-4"><summary>Configuração avançada declarativa</summary>
<label asp-for="CorpoJson">Corpo fixo JSON (sem segredos; campos body do formulário o complementam)</label><textarea asp-for="CorpoJson" rows="4" class="form-control font-monospace"></textarea>
<label asp-for="SchemaJson">Schema JSON de resposta suportado</label><textarea asp-for="SchemaJson" rows="4" class="form-control font-monospace"></textarea>
<label asp-for="Operacao.Correspondencia.Parametro">Parâmetro de identidade (opcional)</label><input asp-for="Operacao.Correspondencia!.Parametro" class="form-control"/>
<label asp-for="Operacao.Correspondencia.Caminho">Caminho da identidade na resposta</label><input asp-for="Operacao.Correspondencia!.Caminho" class="form-control"/>
<label asp-for="Operacao.Correspondencia.Normalizacao">Normalização da identidade</label><select asp-for="Operacao.Correspondencia!.Normalizacao" class="form-select">@foreach(var t in LeadScopeB2B.Integration.Universal.MapeadorApi.Transformacoes){<option>@t</option>}</select>
<label asp-for="Operacao.CabecalhoLimiteRpm">Header oficial de limite RPM (opcional)</label><input asp-for="Operacao.CabecalhoLimiteRpm" class="form-control"/>
<label asp-for="Operacao.CabecalhoRestante">Header oficial de cota restante (opcional)</label><input asp-for="Operacao.CabecalhoRestante" class="form-control"/>
<label asp-for="Operacao.UnidadeCotaCabecalho">Unidade do restante informado pelo header</label><select asp-for="Operacao.UnidadeCotaCabecalho" class="form-select"><option>requisicao</option><option>item</option><option>credito</option></select>
<h3 class="h6 mt-3">Esta operação consulta a cota oficial? (opcional)</h3>
<label class="d-block"><input asp-for="Operacao.ConsultaCota!.NaoConsomeCota"/> O fornecedor documenta que consultar este endpoint não debita a cota de operações.</label>
<label asp-for="Operacao.ConsultaCota!.CaminhoRpm">Caminho JSON do limite RPM</label><input asp-for="Operacao.ConsultaCota!.CaminhoRpm" class="form-control"/>
<label asp-for="Operacao.ConsultaCota!.CaminhoCompetencia">Competência informada (opcional)</label><input asp-for="Operacao.ConsultaCota!.CaminhoCompetencia" class="form-control"/>
<label asp-for="Operacao.ConsultaCota!.CaminhoUsado">Uso informado (opcional)</label><input asp-for="Operacao.ConsultaCota!.CaminhoUsado" class="form-control"/>
<label asp-for="Operacao.ConsultaCota!.CaminhoLimite">Limite informado (opcional)</label><input asp-for="Operacao.ConsultaCota!.CaminhoLimite" class="form-control"/>
<label class="d-block"><input asp-for="Operacao.ConsultaCota!.LimiteZeroSemLimite"/> Limite zero significa ilimitado, conforme documentação do provedor.</label>
<label asp-for="Operacao.ConsultaCota!.CaminhoRenovacao">Renovação informada (opcional)</label><input asp-for="Operacao.ConsultaCota!.CaminhoRenovacao" class="form-control"/>
<label asp-for="Operacao.ConsultaCota!.FormatoRenovacao">Formato declarado da renovação</label><select asp-for="Operacao.ConsultaCota!.FormatoRenovacao" class="form-select"><option>data</option><option>segundos</option><option>unix</option></select>
<label asp-for="Operacao.ConsultaCota!.AtualizarMinutos">Intervalo de atualização do consumo em minutos</label><input asp-for="Operacao.ConsultaCota!.AtualizarMinutos" type="number" min="1" max="1440" class="form-control"/>
<label asp-for="Operacao.ConsultaCota!.CaminhoRestante">Caminho JSON da cota restante</label><input asp-for="Operacao.ConsultaCota!.CaminhoRestante" class="form-control"/>
<label asp-for="Operacao.ConsultaCota!.UnidadeRestante">Unidade da cota retornada</label><select asp-for="Operacao.ConsultaCota!.UnidadeRestante" class="form-select"><option>requisicao</option><option>item</option><option>credito</option></select>
<label class="d-block"><input asp-for="Operacao.ConsultaCota!.RestanteNuloSemLimite"/> O fornecedor documenta restante nulo como ausência de limite.</label>
@foreach(var p in Model.Operacao.CamposOmitidosAmostra){<input type="hidden" name="Operacao.CamposOmitidosAmostra" value="@p"/>}
@foreach(var p in Model.Operacao.Permissoes){<input type="hidden" name="Operacao.Permissoes" value="@p"/>}
</details>
<div class="mt-4"><label class="d-block"><input asp-for="Operacao.Revisada"/> Revisei parâmetros, autenticação, mapeamento, condições e custos.</label><label class="d-block"><input asp-for="Operacao.PermitirEscrita"/> Autorizo que esta operação possa modificar dados externos quando confirmada na execução.</label><label class="d-block"><input asp-for="Operacao.Habilitada"/> Habilitar operação.</label></div>
<button class="btn btn-primary mt-3">Salvar operação</button> <a asp-action="Configurar" asp-route-id="@Model.Id">Voltar</a>
</form>
@section Scripts { <script src="~/js/integracoes-apis.js" asp-append-version="true"></script> }
