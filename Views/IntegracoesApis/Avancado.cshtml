@model LeadScopeB2B.ViewModels.Integracoes.ConfiguracaoApiForm
@{ ViewData["Title"]="Configurar integração"; }
<h1 class="h3">Opções avançadas · @Model.Integracao.Contrato.Provedor</h1>
<p>Estes ajustes são opcionais. Limites descobertos e a política local são administrados pelo motor. <a asp-action="Configurar" asp-route-id="@Model.Id">Voltar à conexão simples</a></p>
<div asp-validation-summary="All" class="text-danger"></div>
<form asp-action="Configurar" method="post">
<input asp-for="Id" type="hidden"/><input asp-for="Revisao" type="hidden"/>
<div class="row g-3"><div class="col-md-4"><label asp-for="Nome">Nome</label><input asp-for="Nome" class="form-control" required/></div><div class="col-md-8"><label asp-for="UrlBase">URL base</label><input asp-for="UrlBase" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="PerfilRede">Perfil de rede do servidor</label><select asp-for="PerfilRede" class="form-select">@foreach(string v in ViewBag.Redes){<option>@v</option>}</select></div>
<div class="col-md-6"><label asp-for="FonteDadosId">Fonte para evidências SQL</label><select asp-for="FonteDadosId" class="form-select"><option value="0">Somente consulta</option>@foreach(FonteDados f in ViewBag.Fontes){<option value="@f.Id">@f.Nome (@f.Id)</option>}</select><a asp-controller="Fontes" asp-action="Index">Gerenciar fontes</a></div></div>
<h2 class="h5 mt-4">Plano e autorização</h2>
<div class="row g-3"><div class="col-md-4"><label asp-for="Plano.Nome">Plano contratado</label><input asp-for="Plano.Nome" class="form-control"/></div><div class="col-md-4"><label asp-for="Plano.Mensalidade">Mensalidade (vazio = desconhecida)</label><input asp-for="Plano.Mensalidade" type="number" min="0" step="0.000001" class="form-control"/></div><div class="col-md-4"><label asp-for="Plano.Moeda">Moeda</label><input asp-for="Plano.Moeda" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Plano.OrcamentoMensal">Orçamento mensal autorizado (vazio = desconhecido)</label><input asp-for="Plano.OrcamentoMensal" type="number" min="0" step="0.000001" class="form-control"/></div><div class="col-md-6"><label asp-for="Plano.CondicoesUso">Condições de uso / funcionalidades contratadas</label><textarea asp-for="Plano.CondicoesUso" class="form-control"></textarea></div></div>
<h2 class="h5 mt-4">Limites contratados informados pelo administrador</h2>
<div class="row g-2"><div class="col"><label asp-for="Plano.Administrador.PorSegundo">Por segundo</label><input asp-for="Plano.Administrador.PorSegundo" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Administrador.PorMinuto">Por minuto</label><input asp-for="Plano.Administrador.PorMinuto" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Administrador.Diario">Diário</label><input asp-for="Plano.Administrador.Diario" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Administrador.Mensal">Mensal</label><input asp-for="Plano.Administrador.Mensal" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Administrador.CreditosMensais">Créditos/mês</label><input asp-for="Plano.Administrador.CreditosMensais" type="number" min="0" step="0.000001" class="form-control"/></div></div>
<h2 class="h5 mt-4">Restrições locais do sistema</h2>
<div class="row g-2"><div class="col"><label asp-for="Plano.Sistema.PorSegundo">Por segundo</label><input asp-for="Plano.Sistema.PorSegundo" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Sistema.PorMinuto">Por minuto</label><input asp-for="Plano.Sistema.PorMinuto" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Sistema.Diario">Diário</label><input asp-for="Plano.Sistema.Diario" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Sistema.Mensal">Mensal</label><input asp-for="Plano.Sistema.Mensal" type="number" min="1" class="form-control"/></div><div class="col"><label asp-for="Plano.Sistema.CreditosMensais">Créditos/mês</label><input asp-for="Plano.Sistema.CreditosMensais" type="number" min="0" step="0.000001" class="form-control"/></div></div>
<p class="small mt-2">O menor limite conhecido é aplicado. Limites desconhecidos ficam vazios. Dia e mês usam UTC. O consumo de outras aplicações não é conhecido por este sistema.</p>
<div class="form-check"><input asp-for="Plano.UsoAutorizado" class="form-check-input"/><label asp-for="Plano.UsoAutorizado" class="form-check-label">Confirmo que o plano e as condições do fornecedor autorizam este uso.</label></div>
<div class="form-check"><input asp-for="Habilitada" class="form-check-input"/><label asp-for="Habilitada" class="form-check-label">Habilitar integração (cada operação também exige revisão e ativação).</label></div>
<button class="btn btn-primary mt-2">Salvar configuração</button>
</form>
@if(Model.Consumo is { } u){<h2 class="h5 mt-4">Limites informados pelo provedor</h2><p>RPM: @(u.RpmProvedor?.ToString() ?? "desconhecido") · cota restante: @(u.RestanteProvedor?.ToString() ?? "desconhecida") @u.UnidadeCotaProvedor · observado em: @(u.CotaObservadaEm?.ToString("u") ?? "não consultado")</p><p>Bloqueio Retry-After: @(u.BloqueadaAte > DateTimeOffset.UtcNow ? u.BloqueadaAte.ToString("u") : "sem bloqueio atual")</p>}
<h2 class="h5 mt-4">Operações</h2><a asp-action="Operacao" asp-route-id="@Model.Id">Adicionar operação</a>
<table class="table"><thead><tr><th>Operação</th><th>Estado / compatibilidade</th><th>Rotina</th><th></th></tr></thead><tbody>
@foreach(var op in Model.Integracao.Contrato.Operacoes){<tr><td>@op.Nome <small class="d-block">@op.Metodo @op.Caminho</small></td><td>@(op.Habilitada?"Habilitada":"Desabilitada")<small class="d-block">@op.Incompatibilidade</small></td><td>@(op.Rotina.Habilitada?$"A cada {op.Rotina.IntervaloMinutos} min":"Desabilitada")</td><td><a asp-action="Operacao" asp-route-id="@Model.Id" asp-route-operacaoId="@op.Id">Editar / mapear</a> · <a asp-action="Executar" asp-route-id="@Model.Id" asp-route-operacaoId="@op.Id">Teste controlado</a></td></tr>}
</tbody></table>
<h2 class="h5 mt-4">Credenciais</h2>
<p>Campos sempre vazios. Preencha somente os segredos que deseja substituir. A atualização invalida tokens OAuth em cache. Remover revoga o segredo local e impede novas autenticações.</p>
@foreach(var a in Model.Integracao.Contrato.Autenticacoes){
<div class="card mb-3"><div class="card-body"><h3 class="h6">@a.Id · @a.Tipo · @(Model.CredenciaisConfiguradas.GetValueOrDefault(a.Id) ?? "Não consultada")</h3>
<form asp-action="Credencial" method="post" autocomplete="off"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="authId" value="@a.Id"/>
@if(a.Tipo is "apiKeyHeader" or "apiKeyQuery" or "bearer" or "basic"){<label class="form-label">@(a.Tipo=="basic"?"Senha":"Chave / token")<input type="password" name="valor" class="form-control" autocomplete="new-password"/></label>}
@if(a.Tipo=="basic"){<label class="form-label">Usuário<input type="text" name="usuario" class="form-control" autocomplete="off"/></label>}
@if(a.Tipo is "clientCredentials" or "authorizationCode"){<label class="form-label">Client ID<input type="password" name="clienteId" class="form-control" autocomplete="new-password"/></label><label class="form-label">Client secret (opcional para cliente público PKCE)<input type="password" name="clienteSegredo" class="form-control" autocomplete="new-password"/></label>}
<button class="btn btn-outline-primary">Salvar credencial</button> <button class="btn btn-outline-danger" name="remover" value="true">Remover credencial</button>
</form>
@if(a.Tipo=="authorizationCode"){
<form asp-action="OAuth" method="post" class="mt-2"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="authId" value="@a.Id"/>
<label class="d-block"><input type="checkbox" name="autorizarCusto" value="true"/> Autorizo a reserva de custo para a troca de token, conforme a operação associada.</label><label class="d-block"><input type="checkbox" name="autorizarCustoDesconhecido" value="true"/> Autorizo custo desconhecido dentro da reserva configurada.</label><button class="btn btn-outline-primary">Conectar conta OAuth com PKCE</button></form>}
</div></div>}
<details><summary>Adicionar ou editar método de autenticação (sem segredos)</summary>
<form asp-action="Autenticacao" method="post" class="mt-2"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="revisao" value="@Model.Revisao"/>
<label>ID da autenticação<input class="form-control" name="autenticacao.Id" required/></label><label>Método<select class="form-select" name="autenticacao.Tipo">@foreach(var v in new[]{"none","apiKeyHeader","apiKeyQuery","bearer","basic","clientCredentials","authorizationCode"}){<option>@v</option>}</select></label>
<label>Nome header/query<input class="form-control" name="autenticacao.Nome"/></label><label>Token endpoint HTTPS<input class="form-control" name="autenticacao.TokenUrl"/></label><label>Authorization endpoint HTTPS<input class="form-control" name="autenticacao.AutorizacaoUrl"/></label><label>Escopos<input class="form-control" name="autenticacao.Escopos"/></label><label>Autenticação do cliente OAuth<select class="form-select" name="autenticacao.EnvioCliente"><option>basic</option><option>body</option></select></label><button class="btn btn-outline-primary mt-2">Salvar método de autenticação</button>
</form></details>
<div class="mt-4"><a asp-action="Contrato" asp-route-id="@Model.Id">Exportar contrato sem segredos</a> · <a asp-action="Index">Voltar ao gerenciador</a></div>
