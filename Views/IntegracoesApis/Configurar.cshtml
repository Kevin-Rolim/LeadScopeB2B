@model LeadScopeB2B.ViewModels.Integracoes.ConfiguracaoApiForm
@{ViewData["Title"]=Model.Integracao.Contrato.Provedor; var api=Model.Integracao; var quota=api.Contrato.Operacoes.FirstOrDefault(o=>o.ConsultaCota is not null); var auth=api.Contrato.Autenticacoes.FirstOrDefault(a=>a.Tipo!="none"); var selecionadas=api.Contrato.Operacoes.Where(o=>o.ConsultaCota is null).ToList(); var risco=selecionadas.Any(o=>o.Custo.PorRequisicao!=0 || o.Custo.PorItem!=0);}
<h1 class="h3">@api.Contrato.Provedor</h1>
<p><strong>@api.EstadoConexao</strong> · @(api.Habilitada?"Integração ativa":"Integração desativada")</p>
@if(api.ErroConexao is not null){<div class="alert alert-warning">@api.ErroConexao</div>}
<form asp-action="Conectar" method="post" autocomplete="off">
<input asp-for="Id" type="hidden"/><input asp-for="Revisao" type="hidden"/>
@if(auth is not null){
<input name="authId" value="@auth.Id" type="hidden"/>
<h2 class="h5">Conexão</h2><p class="small">Credencial: @(Model.CredenciaisConfiguradas.GetValueOrDefault(auth.Id)??"Não configurada"). Deixe vazia para manter a credencial existente. O segredo nunca é exibido.</p>
@if(auth.Tipo is "bearer" or "apiKeyHeader" or "apiKeyQuery" or "basic"){
<label class="form-label">@(auth.Tipo=="basic"?"Senha":"Chave de acesso")<input name="valor" class="form-control" type="password" autocomplete="new-password"/></label>
}
@if(auth.Tipo=="basic"){<label class="form-label">Usuário<input name="usuario" class="form-control" autocomplete="off"/></label>}
@if(auth.Tipo is "clientCredentials" or "authorizationCode"){
<label class="form-label">Client ID<input name="clienteId" class="form-control" type="password" autocomplete="new-password"/></label><label class="form-label">Client secret<input name="clienteSegredo" class="form-control" type="password" autocomplete="new-password"/></label>
}
}else{<p>Esta API não exige credencial.</p>}
<h2 class="h5 mt-3">O que deseja utilizar?</h2>
@foreach(var op in selecionadas){
 var disponivel=op.Incompatibilidade is null && (!LeadScopeB2B.Integration.Universal.ValidacaoContrato.Escrita(op)||op.PermitirEscrita&&op.Revisada);
 <div class="mb-2"><label><input name="Operacoes" value="@op.Id" type="checkbox" checked="@(disponivel&&(api.SelecaoConcluida?api.OperacoesSelecionadas.Contains(op.Id):op.Habilitada||!api.Habilitada))" disabled="@(!disponivel)"/> @op.Nome</label>
 <a class="small ms-2" asp-action="Executar" asp-route-id="@api.Id" asp-route-operacaoId="@op.Id">Consultar</a>
 @if(api.CatalogoId==""){<a class="small ms-2" asp-action="Operacao" asp-route-id="@api.Id" asp-route-operacaoId="@op.Id">Configurar campos</a>}
 @if(!disponivel){<small class="d-block text-muted">Requer revisão nas opções avançadas.</small>}
 </div>
}
@if(selecionadas.Any(o=>o.Parametros.Any(p=>p.CampoOrigem=="" && p.Obrigatorio))){
<details class="mt-3" open="@Model.Automacao"><summary>Valores usados pela automação (quando necessário)</summary>
@foreach(var op in selecionadas){foreach(var p in op.Parametros.Where(p=>p.CampoOrigem=="")){
<label class="form-label d-block mt-2">@op.Nome — @p.Nome<input class="form-control" name="ParametrosAutomacao[@(op.Id+":"+p.Nome)]" value="@(op.Rotina.Parametros.GetValueOrDefault(p.Nome)??p.Padrao)" maxlength="@p.MaxComprimento"/></label>
}}
</details>
}
<label class="d-block mt-3"><input asp-for="Habilitada"/> Ativar integração</label>
<label class="d-block"><input asp-for="Automacao"/> Ativar automação para as operações selecionadas</label>
@if(risco){<label class="d-block mt-2"><input name="AutorizarConsumoCobrado" type="checkbox" value="true" checked="@(api.Contrato.Operacoes.Any(o=>o.Rotina.AutorizarCustoDesconhecido))"/> Autorizo a automação a consumir operações com possível cobrança. O preço não informado permanece desconhecido.</label>}
<p class="small mt-2">Conectar verifica o consumo quando há endpoint oficial gratuito declarado. Nas demais APIs, a credencial é conferida ao executar uma consulta autorizada.</p>
<button class="btn btn-primary">@(api.Habilitada?"Salvar conexão":"Conectar")</button>
</form>
@if(auth?.Tipo=="authorizationCode"){
<form asp-action="OAuth" method="post" class="mt-2"><input name="id" value="@api.Id" type="hidden"/><input name="authId" value="@auth.Id" type="hidden"/><button class="btn btn-outline-primary">Autorizar conta no provedor</button></form>
}
<div class="mt-4"><partial name="_Consumo" model="Model"/></div>
@if(quota is not null && api.Habilitada){<form asp-action="AtualizarConsumo" method="post"><input name="id" value="@api.Id" type="hidden"/><button class="btn btn-sm btn-outline-secondary">Atualizar informações disponíveis</button></form>}
<p class="small mt-3">@(api.Contrato.Capacidades.GratuidadeDocumentada?"Gratuidade documentada para as operações disponíveis.":risco?"Custo não informado pelo provedor; nenhum preço ou plano é inferido a partir da cota.":"Custos por operação conforme o contrato fornecido.")</p>
<details class="mt-3"><summary>Mais opções</summary><p class="mt-2"><a asp-action="Avancado" asp-route-id="@api.Id">Configuração técnica, tetos opcionais e credenciais adicionais</a></p><p><a asp-action="Contrato" asp-route-id="@api.Id">Exportar contrato sem segredos</a></p></details>
<a asp-action="Index" class="d-inline-block mt-3">Voltar às integrações</a>
