# Copie este arquivo para .env (privado; não é versionado).
# Troque as senhas. Use senha forte com maiúsculas, minúsculas, números e símbolo.
# Para a conexão ADO.NET, evite ponto e vírgula, aspas e quebra de linha na senha do SQL.
MSSQL_SA_PASSWORD=ALTERE_ESTA_SENHA_2026_Forte!

# Primeira instalação: conta administrativa é criada apenas se ainda não existem usuários.
# Em bases com usuários, estes valores são ignorados e nenhuma senha é alterada.
LEADSCOPE_ADMIN_NOME=Administrador
LEADSCOPE_ADMIN_EMAIL=admin@exemplo.com
LEADSCOPE_ADMIN_SENHA=ALTERE_ESTA_SENHA_ADMIN_2026!

# Portas opcionais no próprio computador (não expostas na rede).
LEADSCOPE_SQL_PORT=14331
LEADSCOPE_HTTP_PORT=18080
